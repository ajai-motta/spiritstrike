<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/bgColor"
    android:paddingLeft="@dimen/hive_device_management_size_30"
    android:paddingTop="@dimen/hive_device_management_size_20"
    android:paddingRight="@dimen/hive_device_management_size_30"
    android:paddingBottom="@dimen/hive_device_management_size_20"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:paddingHorizontal="@dimen/hive_device_management_size_30"
    android:paddingVertical="@dimen/hive_device_management_size_20">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/hive_device_management_main"
        android:background="?attr/hiveDefaultPopupBackground"
        android:padding="@dimen/hive_device_management_size_20"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/hive_device_management_width_max">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/hive_device_management_font_size_20"
            android:textStyle="bold"
            android:textColor="?attr/fontPopupMain"
            android:gravity="left"
            android:id="@+id/hive_device_management_title"
            android:paddingLeft="@dimen/hive_device_management_size_10"
            android:paddingRight="@dimen/hive_device_management_size_10"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/hive_device_management_397"
            android:lineSpacingExtra="2sp"
            android:layout_marginEnd="@dimen/hive_device_management_button_close_size"
            android:paddingHorizontal="@dimen/hive_device_management_size_10"
            app:layout_constraintBottom_toTopOf="@+id/hive_device_management_scrollview"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.core.widget.NestedScrollView
            android:scrollbarSize="3dp"
            android:scrollbarThumbVertical="?attr/hiveDefaultPopupScrollbar"
            android:scrollbarStyle="outsideInset"
            android:id="@+id/hive_device_management_scrollview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hive_device_management_size_10"
            android:layout_marginBottom="@dimen/hive_device_management_size_30"
            android:fadeScrollbars="true"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@+id/hive_device_management_active_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hive_device_management_title">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/hive_device_management_font_size_18"
                    android:textStyle="normal"
                    android:textColor="?attr/btnPopupActive"
                    android:gravity="left"
                    android:id="@+id/hive_device_management_sub_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hive_device_management_398"
                    android:lineSpacingExtra="2sp"
                    app:layout_constrainedHeight="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/hive_device_management_font_size_16"
                    android:textStyle="normal"
                    android:textColor="?attr/fontPopupSub"
                    android:gravity="left"
                    android:layout_gravity="start"
                    android:id="@+id/hive_device_management_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/hive_device_management_size_10"
                    android:text="@string/hive_device_management_399"
                    android:lineSpacingExtra="2sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/hive_device_management_sub_title"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/hive_device_management_font_size_16"
            android:textStyle="normal"
            android:textColor="?attr/commonWhite"
            android:gravity="center"
            android:id="@+id/hive_device_management_cancel_button"
            android:background="?attr/hiveDefaultPopupSubButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/hive_device_management_button_height"
            android:text="@string/hive_device_management_99"
            android:lineSpacingExtra="2sp"
            android:layout_marginEnd="@dimen/hive_device_management_size_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/hive_device_management_active_button"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/hive_device_management_font_size_16"
            android:textStyle="normal"
            android:textColor="?attr/commonWhite"
            android:gravity="center"
            android:id="@+id/hive_device_management_active_button"
            android:background="?attr/hiveDefaultPopupMainButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/hive_device_management_button_height"
            android:text="@string/hive_device_management_136"
            android:lineSpacingExtra="2sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/hive_device_management_cancel_button"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/hive_device_management_button_question"
        android:padding="@dimen/hive_device_management_size_10"
        android:layout_width="@dimen/hive_device_management_button_close_size"
        android:layout_height="@dimen/hive_device_management_button_close_size"
        app:layout_constraintEnd_toEndOf="@+id/hive_device_management_main"
        app:layout_constraintTop_toTopOf="@+id/hive_device_management_main"
        app:srcCompat="?attr/hiveIconQuestion"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/hive_device_management_popup_board"
        android:background="?attr/hiveDeviceManagementPopupBoard"
        android:visibility="gone"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layoutDirection="ltr"
        app:layout_constraintBottom_toBottomOf="@+id/hive_device_management_main"
        app:layout_constraintEnd_toEndOf="@+id/hive_device_management_main"
        app:layout_constraintStart_toStartOf="@+id/hive_device_management_main"
        app:layout_constraintTop_toTopOf="@+id/hive_device_management_main"
        app:layout_constraintWidth_max="@dimen/hive_device_management_width_max">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/hive_device_management_btn_close"
            android:padding="@dimen/hive_device_management_size_10"
            android:layout_width="@dimen/hive_device_management_button_close_size"
            android:layout_height="@dimen/hive_device_management_button_close_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/hive_device_management_dk_btn_close"/>
        <androidx.core.widget.NestedScrollView
            android:scrollbarSize="3dp"
            android:scrollbarThumbVertical="?attr/hiveDefaultPopupScrollbar"
            android:scrollbarStyle="outsideInset"
            android:paddingLeft="@dimen/hive_device_management_size_20"
            android:paddingTop="@dimen/hive_device_management_button_close_size"
            android:paddingRight="@dimen/hive_device_management_size_20"
            android:paddingBottom="@dimen/hive_device_management_button_close_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadeScrollbars="true"
            android:paddingHorizontal="@dimen/hive_device_management_size_20"
            android:paddingVertical="@dimen/hive_device_management_button_close_size"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/hive_device_management_font_size_16"
                    android:textStyle="normal"
                    android:textColor="?attr/commonWhite"
                    android:gravity="left"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/hive_device_management_407"
                    android:lineSpacingExtra="2sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
