<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/hiveConsentModeFormDescriptionBgColor"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <com.hive.ui.view.HiveAnimationButton
        android:id="@+id/hive_consent_mode_button_back"
        android:paddingTop="18dp"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:paddingStart="18dp"
        app:OffAnimation="?attr/hiveConsentModeFormDetailBackButtonOff"
        app:OnAnimation="?attr/hiveConsentModeFormDetailBackButtonOn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/hiveConsentModeFormDetailBackButtonOn"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="top"
        android:id="@+id/hive_consent_mode_main"
        android:paddingLeft="30dp"
        android:paddingTop="10dp"
        android:paddingRight="30dp"
        android:paddingBottom="20dp"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layoutDirection="ltr"
        android:paddingHorizontal="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hive_consent_mode_button_back"
        app:layout_constraintWidth_max="600dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/fontPagesMain"
            android:gravity="left"
            android:id="@+id/hive_consent_mode_form_detail_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hive_consent_mode_text_ad_user_data_title"
            android:lineSpacingExtra="2sp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@+id/hive_consent_mode_form_detail_scroll"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.core.widget.NestedScrollView
            android:scrollbarSize="6dp"
            android:scrollbarThumbVertical="?attr/hiveDefaultPopupScrollbar"
            android:scrollbarStyle="outsideInset"
            android:id="@+id/hive_consent_mode_form_detail_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/hive_consent_mode_contents_margin_30"
            android:fadeScrollbars="true"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hive_consent_mode_form_detail_title">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:textStyle="normal"
                android:textColor="?attr/fontPagesSub"
                android:gravity="left"
                android:id="@+id/hive_consent_mode_form_detail_contents"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/hive_consent_mode_text_ad_user_data_content"
                android:lineSpacingExtra="2sp"/>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
