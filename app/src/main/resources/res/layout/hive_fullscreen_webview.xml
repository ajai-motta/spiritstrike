<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.hive.core.webview.HiveWebView
            android:id="@+id/hive_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.hive.ui.view.HiveAnimationButton
            android:id="@+id/hive_close_button"
            android:layout_width="@dimen/authv4_dialog_close_btn_size"
            android:layout_height="@dimen/authv4_dialog_close_btn_size"
            android:layout_marginTop="@dimen/authv4_dialog_close_btn_margin"
            android:layout_marginRight="@dimen/authv4_dialog_close_btn_margin"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            app:OffAnimation="@drawable/hive_fullscreen_webview_close_btn_up_to_down"
            app:OnAnimation="@drawable/hive_fullscreen_webview_close_btn_down_to_up"
            app:srcCompat="@drawable/hive_fullscreen_webview_close_btn_down_to_up"/>
    </RelativeLayout>
</LinearLayout>
