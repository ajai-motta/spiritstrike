<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/promotion_view_banner_root"
    android:background="#00000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="430:1024"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <Space
            android:id="@+id/promotion_view_banner_margin_start"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_default="percent"
            app:layout_constraintWidth_percent="0.0232"/>
        <Space
            android:id="@+id/promotion_view_banner_margin_top"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_default="percent"
            app:layout_constraintHeight_percent="0.1201"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <Space
            android:id="@+id/promotion_view_banner_margin_end"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_default="percent"
            app:layout_constraintWidth_percent="0.0232"/>
        <Space
            android:id="@+id/promotion_view_banner_margin_bottom"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_default="percent"
            app:layout_constraintHeight_percent="0.1142"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/promotion_view_banner_parent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/promotion_view_banner_margin_bottom"
            app:layout_constraintEnd_toStartOf="@+id/promotion_view_banner_margin_end"
            app:layout_constraintStart_toEndOf="@+id/promotion_view_banner_margin_start"
            app:layout_constraintTop_toBottomOf="@+id/promotion_view_banner_margin_top">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/promotion_view_banner_child_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constrainedHeight="true"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toTopOf="@+id/promotion_view_footer_layout"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5"
                app:layout_constraintVertical_chainStyle="packed">
                <com.hive.promotion.PromotionCustomViewRoundedCorner
                    android:background="#00000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constrainedHeight="true"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:round="16dp">
                    <ImageView
                        android:id="@+id/promotion_view_custom_imageview"
                        android:background="#00000000"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:cropToPadding="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </com.hive.promotion.PromotionCustomViewRoundedCorner>
                <com.hive.promotion.PromotionCustomViewRoundedCorner
                    android:id="@+id/promotion_view_banner_child_layout_top"
                    android:background="#00000000"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="9:16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:round="16dp">
                    <ProgressBar
                        android:layout_gravity="center"
                        android:id="@+id/promotion_view_spinner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <com.hive.core.webview.HiveWebView
                        android:id="@+id/promotion_view_custom_webview"
                        android:background="#00000000"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </com.hive.promotion.PromotionCustomViewRoundedCorner>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/promotion_banner_remain_time_layout"
                        android:background="@drawable/promotion_banner_remain_time_layout"
                        android:visibility="invisible"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_margin="12dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="382:50"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="1">
                        <Space
                            android:id="@+id/promotion_banner_remain_time_layout_padding_left"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintDimensionRatio="1:2"
                            app:layout_constraintEnd_toStartOf="@+id/remain_time_icon"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintHorizontal_chainStyle="packed"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/remain_time_icon"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintDimensionRatio="16:20"
                            app:layout_constraintEnd_toStartOf="@+id/remain_time_tile_textView_margin_left"
                            app:layout_constraintHeight_default="percent"
                            app:layout_constraintHeight_percent="0.5"
                            app:layout_constraintStart_toEndOf="@+id/promotion_banner_remain_time_layout_padding_left"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/promotion_banner_timer_vector"/>
                        <Space
                            android:id="@+id/remain_time_tile_textView_margin_left"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintDimensionRatio="1:10"
                            app:layout_constraintEnd_toStartOf="@+id/remain_time_title_textView"
                            app:layout_constraintStart_toEndOf="@+id/remain_time_icon"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textStyle="bold"
                            android:textColor="@color/com_hive_sdk_promotion_banner_remain_time_title_text_color"
                            android:id="@+id/remain_time_title_textView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hive_promotion_banner_remain_time_title"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/remain_time_textView_margin_left"
                            app:layout_constraintStart_toEndOf="@+id/remain_time_tile_textView_margin_left"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <Space
                            android:id="@+id/remain_time_textView_margin_left"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintDimensionRatio="1:5"
                            app:layout_constraintEnd_toEndOf="@+id/remain_time_textView"
                            app:layout_constraintStart_toEndOf="@+id/remain_time_title_textView"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textColor="@color/com_hive_sdk_promotion_banner_remain_time_text_color"
                            android:id="@+id/remain_time_textView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hive_promotion_banner_remain_time_timer"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/promotion_banner_remain_time_layout_padding_right"
                            app:layout_constraintStart_toEndOf="@+id/remain_time_textView_margin_left"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <Space
                            android:id="@+id/promotion_banner_remain_time_layout_padding_right"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintDimensionRatio="1:2"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/remain_time_textView"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/promotion_view_footer_layout"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/promotion_view_banner_child_layout"
                app:layout_constraintHeight_default="percent"
                app:layout_constraintHeight_percent="0.0714"
                app:layout_constraintStart_toStartOf="@+id/promotion_view_banner_child_layout"
                app:layout_constraintTop_toBottomOf="@+id/promotion_view_banner_child_layout"
                app:layout_constraintVertical_bias="1">
                <Space
                    android:id="@+id/promotion_view_footer_layout_margin_bottom"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_default="percent"
                    app:layout_constraintHeight_percent="0.1785"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/promotion_view_banner_force_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/promotion_view_banner_close_btn"
                    app:layout_constraintHeight_default="percent"
                    app:layout_constraintHeight_percent="0.7142"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/promotion_view_footer_layout_margin_bottom"
                    app:layout_constraintVertical_bias="0.5">
                    <Space
                        android:id="@+id/promotion_view_banner_force_btn_margin_left"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="5:30"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/promotion_view_banner_force_btn"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintStart_toEndOf="@+id/promotion_view_banner_force_btn_margin_left"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/promotion_banner_force_from_off_to_on"/>
                    <Space
                        android:id="@+id/promotion_view_banner_force_textview_margin_left"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="5:30"
                        app:layout_constraintStart_toEndOf="@+id/promotion_view_banner_force_btn"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textColor="@color/com_hive_sdk_promotion_banner_force_text_off_color"
                        android:id="@+id/promotion_view_banner_force_textview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hive_promotion_style_banner"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/promotion_view_banner_force_textview_margin_left"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/promotion_view_banner_close_btn"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_default="percent"
                    app:layout_constraintHeight_percent="0.8214"
                    app:layout_constraintHorizontal_bias="1"
                    app:layout_constraintTop_toBottomOf="@+id/promotion_view_footer_layout_margin_bottom"
                    app:layout_constraintVertical_bias="1"
                    app:srcCompat="@drawable/promotion_banner_close_from_down_to_up"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
