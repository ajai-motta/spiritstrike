<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/bgPages"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/hive_consent_mode_main"
        android:paddingLeft="30dp"
        android:paddingTop="36dp"
        android:paddingRight="30dp"
        android:paddingBottom="20dp"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:paddingHorizontal="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="600dp">
        <androidx.core.widget.NestedScrollView
            android:scrollbarSize="3dp"
            android:scrollbarThumbVertical="?attr/hiveDefaultPopupScrollbar"
            android:scrollbarStyle="outsideInset"
            android:id="@+id/nestedScrollView"
            android:scrollbars="vertical"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fadeScrollbars="true"
            app:layout_constraintBottom_toTopOf="@+id/hive_consent_mode_bottom_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/fontPagesMain"
                    android:gravity="left"
                    android:id="@+id/hive_consent_mode_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hive_consent_mode_text_title"
                    android:lineSpacingExtra="8sp"
                    android:layout_marginEnd="20dp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/hive_consent_mode_recycler_view"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/hive_consent_mode_recycler_view_margin_top"
                    android:overScrollMode="never"
                    android:nestedScrollingEnabled="false"
                    app:layout_constrainedHeight="true"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/hive_consent_mode_bottom_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hive_consent_mode_contents_margin_30"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/nestedScrollView">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/commonWhite"
                android:gravity="center"
                android:id="@+id/hive_consent_mode_sub_button"
                android:background="?attr/hiveConsentModeSubButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_marginBottom="10dp"
                android:text="@string/hive_consent_mode_text_click_all"
                android:lineSpacingExtra="2sp"
                android:layout_marginEnd="10dp"
                app:layout_constraintBottom_toTopOf="@+id/hive_consent_mode_privacy_policy"
                app:layout_constraintEnd_toStartOf="@+id/hive_consent_mode_main_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/commonWhite"
                android:gravity="center"
                android:id="@+id/hive_consent_mode_main_button"
                android:background="?attr/hiveDefaultPopupMainButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_marginBottom="10dp"
                android:text="@string/hive_consent_mode_text_submit"
                android:lineSpacingExtra="2sp"
                app:layout_constraintBottom_toTopOf="@+id/hive_consent_mode_privacy_policy"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/hive_consent_mode_sub_button"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16sp"
                android:textStyle="normal"
                android:textColor="?attr/hiveConsentModeHyperLinkColor"
                android:gravity="center"
                android:id="@+id/hive_consent_mode_privacy_policy"
                android:paddingTop="10dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/hive_consent_mode_text_privacy_policy"
                android:lineSpacingExtra="2sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/hive_consent_mode_main_button"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.hive.ui.view.HiveAnimationButton
        android:id="@+id/hive_consent_mode_button_close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="18dp"
        app:OffAnimation="?attr/authv4CloseBtnUp"
        app:OnAnimation="?attr/authv4CloseBtnDown"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/authv4CloseBtnDown"/>
</androidx.constraintlayout.widget.ConstraintLayout>
