<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/bgColor"
    android:paddingLeft="@dimen/hive_device_management_size_30"
    android:paddingTop="@dimen/hive_device_management_size_20"
    android:paddingRight="@dimen/hive_device_management_size_30"
    android:paddingBottom="@dimen/hive_device_management_size_20"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:paddingHorizontal="@dimen/hive_device_management_size_30"
    android:paddingVertical="@dimen/hive_device_management_size_20">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/hive_device_management_main"
        android:background="?attr/hiveDefaultPopupBackground"
        android:padding="@dimen/hive_device_management_size_20"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/hive_device_management_width_max">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/hive_device_management_font_size_20"
            android:textStyle="bold"
            android:textColor="?attr/fontPopupMain"
            android:gravity="left"
            android:id="@+id/hive_device_management_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hive_device_management_112"
            android:lineSpacingExtra="2sp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="@dimen/hive_device_management_button_close_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.core.widget.NestedScrollView
            android:scrollbarSize="3dp"
            android:scrollbarThumbVertical="?attr/hiveDefaultPopupScrollbar"
            android:scrollbarStyle="outsideInset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hive_device_management_size_10"
            android:layout_marginBottom="@dimen/hive_device_management_size_30"
            android:fadeScrollbars="true"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@+id/hive_device_management_active_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hive_device_management_title">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/hive_device_management_font_size_16"
                    android:textStyle="normal"
                    android:textColor="?attr/fontPopupSub"
                    android:gravity="left"
                    android:layout_gravity="start"
                    android:id="@+id/hive_device_management_text_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/hive_device_management_size_4"
                    android:text="@string/hive_device_management_123"
                    android:lineSpacingExtra="2sp"
                    app:layout_constraintBottom_toTopOf="@+id/hive_device_management_non_editable"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/hive_device_management_font_size_16"
                    android:textStyle="normal"
                    android:textColor="?attr/fontPopupMain"
                    android:textColorHint="?attr/hiveFontColorInputDefault"
                    android:gravity="center"
                    android:id="@+id/hive_device_management_non_editable"
                    android:background="?attr/hiveButtonInput"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hive_device_management_button_height"
                    android:layout_marginBottom="@dimen/hive_device_management_size_10"
                    android:paddingHorizontal="20dp"
                    app:layout_constraintBottom_toTopOf="@+id/hive_device_management_text_2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/hive_device_management_text_1"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/hive_device_management_font_size_16"
                    android:textStyle="normal"
                    android:textColor="?attr/fontPopupSub"
                    android:gravity="left"
                    android:layout_gravity="start"
                    android:id="@+id/hive_device_management_text_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/hive_device_management_size_4"
                    android:text="@string/hive_device_management_124"
                    android:lineSpacingExtra="2sp"
                    app:layout_constraintBottom_toTopOf="@+id/hive_device_management_phone_code_spinner"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/hive_device_management_non_editable"/>
                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/hive_device_management_phone_code_spinner"
                    android:background="?attr/hiveButtonDropdown"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/hive_device_management_button_height"
                    android:layout_marginBottom="@dimen/hive_device_management_size_10"
                    android:spinnerMode="dropdown"
                    android:paddingHorizontal="10dp"
                    app:layout_constraintBottom_toTopOf="@+id/hive_device_management_button_input_1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/hive_device_management_text_2"
                    app:layout_constraintWidth_default="spread"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/hive_device_management_btn_dropdown_arrow_down"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginHorizontal="20dp"
                    app:layout_constraintBottom_toBottomOf="@+id/hive_device_management_phone_code_spinner"
                    app:layout_constraintEnd_toEndOf="@+id/hive_device_management_phone_code_spinner"
                    app:layout_constraintTop_toTopOf="@+id/hive_device_management_phone_code_spinner"
                    app:srcCompat="?attr/hiveButtonDropdownArrowDown"/>
                <androidx.appcompat.widget.AppCompatEditText
                    android:textSize="@dimen/hive_device_management_font_size_16"
                    android:textStyle="normal"
                    android:textColor="?attr/fontPopupMain"
                    android:textColorHint="?attr/hiveFontColorInputDefault"
                    android:gravity="center"
                    android:id="@+id/hive_device_management_button_input_1"
                    android:background="?attr/hiveButtonInput"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hive_device_management_button_height"
                    android:layout_marginBottom="@dimen/hive_device_management_size_4"
                    android:hint="@string/hive_device_management_185"
                    android:maxLength="24"
                    android:inputType="number"
                    android:imeOptions="flagNoExtractUi"
                    android:paddingHorizontal="20dp"
                    app:layout_constraintBottom_toTopOf="@+id/hive_device_management_error_message_1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/hive_device_management_phone_code_spinner"
                    app:layout_goneMarginBottom="@dimen/hive_device_management_size_20"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/hive_device_management_font_size_12"
                    android:textColor="?attr/hiveDeviceManagementFontColorErrorMessage"
                    android:gravity="left"
                    android:id="@+id/hive_device_management_error_message_1"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="@dimen/hive_device_management_size_10"
                    android:text="@string/hive_device_management_144"
                    android:lineSpacingExtra="2sp"
                    android:layout_marginHorizontal="10dp"
                    app:layout_constrainedHeight="true"
                    app:layout_constraintBottom_toTopOf="@+id/hive_device_management_send_verification_code_button"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/hive_device_management_button_input_1"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/hive_device_management_font_size_16"
                    android:textStyle="normal"
                    android:textColor="?attr/hiveDeviceManagementFontColorInActive"
                    android:gravity="center"
                    android:id="@+id/hive_device_management_send_verification_code_button"
                    android:background="?attr/hiveDeviceManagementButtonInActive"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/hive_device_management_button_height"
                    android:layout_marginBottom="@dimen/hive_device_management_size_10"
                    android:text="@string/hive_device_management_126"
                    android:lineSpacingExtra="2sp"
                    app:layout_constraintBottom_toBottomOf="@+id/hive_device_management_time_limit"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/hive_device_management_error_message_1"
                    app:layout_goneMarginBottom="@dimen/hive_device_management_size_20"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/hive_device_management_font_size_14"
                    android:textColor="?attr/hiveDeviceManagementFontColorErrorMessage"
                    android:gravity="left"
                    android:id="@+id/hive_device_management_time_limit"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="@dimen/hive_device_management_size_4"
                    android:lineSpacingExtra="2sp"
                    android:layout_marginHorizontal="10dp"
                    app:layout_constrainedHeight="true"
                    app:layout_constraintBottom_toTopOf="@+id/hive_device_management_button_input_2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/hive_device_management_send_verification_code_button"/>
                <androidx.appcompat.widget.AppCompatEditText
                    android:enabled="false"
                    android:textSize="@dimen/hive_device_management_font_size_16"
                    android:textStyle="normal"
                    android:textColor="?attr/fontPopupMain"
                    android:textColorHint="?attr/hiveFontColorInputDefault"
                    android:gravity="center"
                    android:id="@+id/hive_device_management_button_input_2"
                    android:background="?attr/hiveButtonInput"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hive_device_management_button_height"
                    android:layout_marginBottom="@dimen/hive_device_management_size_4"
                    android:hint="@string/hive_device_management_146"
                    android:maxLength="6"
                    android:inputType="number"
                    android:imeOptions="flagNoExtractUi"
                    android:paddingHorizontal="20dp"
                    app:layout_constraintBottom_toTopOf="@+id/hive_device_management_error_message_2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/hive_device_management_time_limit"
                    app:layout_goneMarginBottom="@dimen/hive_device_management_size_20"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/hive_device_management_font_size_14"
                    android:textColor="?attr/btnPagesActive"
                    android:gravity="center"
                    android:id="@+id/hive_device_management_btn_resend"
                    android:padding="@dimen/hive_device_management_size_10"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/hive_device_management_size_10"
                    android:layout_marginRight="@dimen/hive_device_management_size_10"
                    android:text="@string/hive_device_management_116"
                    android:layout_marginHorizontal="@dimen/hive_device_management_size_10"
                    app:layout_constraintBottom_toBottomOf="@+id/hive_device_management_button_input_2"
                    app:layout_constraintEnd_toEndOf="@+id/hive_device_management_button_input_2"
                    app:layout_constraintTop_toTopOf="@+id/hive_device_management_button_input_2"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/hive_device_management_font_size_12"
                    android:textColor="?attr/hiveDeviceManagementFontColorErrorMessage"
                    android:gravity="left"
                    android:id="@+id/hive_device_management_error_message_2"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="@dimen/hive_device_management_size_10"
                    android:text="@string/hive_device_management_120"
                    android:lineSpacingExtra="2sp"
                    android:layout_marginHorizontal="10dp"
                    app:layout_constrainedHeight="true"
                    app:layout_constraintBottom_toTopOf="@+id/hive_device_management_check_layout"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/hive_device_management_button_input_2"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/hive_device_management_check_layout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/hive_device_management_size_4"
                    app:layout_constrainedHeight="true"
                    app:layout_constraintBottom_toTopOf="@+id/hive_device_management_content"
                    app:layout_constraintEnd_toStartOf="@+id/hive_device_management_btn_more"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/hive_device_management_error_message_2">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/hive_device_management_btn_check"
                        android:layout_width="@dimen/hive_device_management_check_button_size"
                        android:layout_height="@dimen/hive_device_management_check_button_size"
                        android:layout_marginTop="@dimen/hive_device_management_size_4"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/hive_device_management_sub_title"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="?attr/hiveDeviceManagementButtonCheckOff"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/hive_device_management_font_size_12"
                        android:textStyle="normal"
                        android:textColor="?attr/fontPopupMain"
                        android:gravity="left"
                        android:id="@+id/hive_device_management_sub_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/hive_device_management_127"
                        android:lineSpacingExtra="2sp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        app:layout_constrainedHeight="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/hive_device_management_btn_check"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/hive_device_management_btn_more"
                    android:layout_width="@dimen/hive_device_management_check_button_size"
                    android:layout_height="@dimen/hive_device_management_check_button_size"
                    app:layout_constraintBottom_toBottomOf="@+id/hive_device_management_check_layout"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/hive_device_management_check_layout"
                    app:layout_constraintTop_toTopOf="@+id/hive_device_management_check_layout"
                    app:srcCompat="?attr/hiveDeviceManagementButtonMore"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/hive_device_management_font_size_12"
                    android:textStyle="normal"
                    android:textColor="?attr/fontPopupSub"
                    android:gravity="left"
                    android:layout_gravity="start"
                    android:id="@+id/hive_device_management_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hive_device_management_129"
                    android:lineSpacingExtra="2sp"
                    android:layout_marginStart="@dimen/hive_device_management_collection_personal_information_content_margin"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/hive_device_management_check_layout"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/hive_device_management_font_size_16"
            android:textStyle="normal"
            android:textColor="?attr/commonWhite"
            android:gravity="center"
            android:id="@+id/hive_device_management_cancel_button"
            android:background="?attr/hiveDefaultPopupSubButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/hive_device_management_button_height"
            android:text="@string/hive_device_management_99"
            android:lineSpacingExtra="2sp"
            android:layout_marginEnd="@dimen/hive_device_management_size_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/hive_device_management_active_button"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/hive_device_management_font_size_16"
            android:textStyle="normal"
            android:textColor="?attr/hiveDeviceManagementFontColorInActive"
            android:gravity="center"
            android:id="@+id/hive_device_management_active_button"
            android:background="?attr/hiveDeviceManagementButtonInActive"
            android:layout_width="0dp"
            android:layout_height="@dimen/hive_device_management_button_height"
            android:text="@string/hive_device_management_107"
            android:lineSpacingExtra="2sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/hive_device_management_cancel_button"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/hive_device_management_button_close"
        android:padding="@dimen/hive_device_management_size_10"
        android:layout_width="@dimen/hive_device_management_button_close_size"
        android:layout_height="@dimen/hive_device_management_button_close_size"
        app:layout_constraintEnd_toEndOf="@+id/hive_device_management_main"
        app:layout_constraintTop_toTopOf="@+id/hive_device_management_main"
        app:srcCompat="?attr/hiveButtonClose"/>
</androidx.constraintlayout.widget.ConstraintLayout>
