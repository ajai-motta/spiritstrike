<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/com_hive_sdk_default_popup_size_20"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/popupLayout"
        android:background="?attr/hiveDefaultPopupBackground"
        android:padding="@dimen/com_hive_sdk_default_popup_size_20"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/com_hive_sdk_default_popup_width">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/com_hive_sdk_default_popup_timer_text_size"
            android:textStyle="normal"
            android:textColor="?attr/fontPopupRed"
            android:gravity="left"
            android:id="@+id/hive_default_popup_dialog_timer"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/hive_promotion_review_time"
            android:layout_marginEnd="@dimen/com_hive_sdk_default_popup_title_end_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.core.widget.NestedScrollView
            android:scrollbarSize="6dp"
            android:scrollbarThumbVertical="?attr/hiveDefaultPopupScrollbar"
            android:scrollbarStyle="outsideInset"
            android:id="@+id/hive_default_popup_scroll_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/com_hive_sdk_default_popup_size_10"
            android:layout_marginBottom="@dimen/com_hive_sdk_default_popup_size_20"
            android:fadeScrollbars="false"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@+id/hive_default_popup_dialog_main_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_max="@dimen/com_hive_sdk_default_popup_scroll_max_height"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hive_default_popup_dialog_timer"
            app:layout_goneMarginTop="0dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/hive_promotion_review_popup_star"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toTopOf="@+id/hive_default_popup_dialog_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/hive_promotion_review_star"/>
                <com.hive.ui.view.HiveTextView
                    android:textSize="@dimen/com_hive_sdk_default_popup_title_text_size"
                    android:textStyle="normal"
                    android:textColor="?attr/fontPopupMain"
                    android:gravity="left"
                    android:id="@+id/hive_default_popup_dialog_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:layout_constraintBottom_toTopOf="@+id/hive_default_popup_dialog_message"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/hive_promotion_review_popup_star"
                    app:layout_goneMarginTop="0dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/com_hive_sdk_default_popup_message_text_size"
                    android:textStyle="normal"
                    android:textColor="?attr/fontPopupSub"
                    android:gravity="left"
                    android:id="@+id/hive_default_popup_dialog_message"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/com_hive_sdk_default_popup_size_10"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/hive_default_popup_dialog_title"
                    app:layout_goneMarginTop="0dp"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/com_hive_sdk_default_popup_btn_text_size"
            android:textStyle="normal"
            android:textColor="?attr/commonWhite"
            android:gravity="center"
            android:id="@+id/hive_default_popup_dialog_sub_button"
            android:background="?attr/hiveDefaultPopupSubButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/com_hive_sdk_default_popup_btn_height"
            android:text="@string/hive_promotion_review_button_left"
            android:lineSpacingExtra="2sp"
            android:layout_marginEnd="@dimen/com_hive_sdk_default_popup_btn_space_width"
            app:layout_constraintBaseline_toBaselineOf="@+id/hive_default_popup_dialog_main_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/hive_default_popup_dialog_main_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hive_default_popup_scroll_view"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/com_hive_sdk_default_popup_btn_text_size"
            android:textStyle="normal"
            android:textColor="?attr/commonWhite"
            android:gravity="center"
            android:id="@+id/hive_default_popup_dialog_main_button"
            android:background="?attr/hiveDefaultPopupMainButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/com_hive_sdk_default_popup_btn_height"
            android:text="@string/hive_promotion_review_button_right"
            android:lineSpacingExtra="2sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/hive_default_popup_dialog_sub_button"
            app:layout_constraintTop_toBottomOf="@+id/hive_default_popup_scroll_view"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.hive.ui.view.HiveAnimationButton
        android:id="@+id/hive_default_popup_dialog_close"
        android:padding="@dimen/com_hive_sdk_default_popup_size_8"
        android:layout_width="@dimen/com_hive_sdk_default_popup_close_btn_size"
        android:layout_height="@dimen/com_hive_sdk_default_popup_close_btn_size"
        app:OffAnimation="?attr/authv4CloseBtnUp"
        app:OnAnimation="?attr/authv4CloseBtnDown"
        app:layout_constraintEnd_toEndOf="@+id/popupLayout"
        app:layout_constraintTop_toTopOf="@+id/popupLayout"
        app:srcCompat="?attr/authv4CloseBtnDown"/>
</androidx.constraintlayout.widget.ConstraintLayout>
