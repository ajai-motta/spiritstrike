<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <FrameLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center"
            android:background="?attr/hiveDefaultPopupBackground"
            android:layout_width="@dimen/com_hive_sdk_permission_popup_width"
            android:layout_height="wrap_content">
            <Space
                android:id="@+id/hive_permission_top_margin"
                android:layout_width="match_parent"
                android:layout_height="@dimen/com_hive_sdk_default_popup_top_margin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.hive.ui.view.MaxHeightScrollView
                android:scrollbarThumbVertical="?attr/hiveDefaultPopupScrollbar"
                android:scrollbarStyle="outsideInset"
                android:id="@+id/hive_permission_scroll_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/com_hive_sdk_default_popup_margin_horizontal"
                android:layout_marginRight="@dimen/com_hive_sdk_default_popup_margin_horizontal"
                android:fadeScrollbars="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/hive_permission_top_margin"
                app:maxHeight="@dimen/com_hive_sdk_permission_scroll_max_height">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/hive_permission_scroll_content_linear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/com_hive_sdk_permission_title_text_size"
                        android:textStyle="normal"
                        android:textColor="?attr/fontPopupMain"
                        android:gravity="left"
                        android:id="@+id/hive_permission_dialog_title"
                        android:layout_width="@dimen/com_hive_sdk_permission_popup_inner_width"
                        android:layout_height="wrap_content"
                        android:text="@string/hive_permission_ui_title"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/com_hive_sdk_default_popup_message_text_size"
                        android:textStyle="normal"
                        android:textColor="?attr/fontPopupSub"
                        android:gravity="left"
                        android:id="@+id/hive_permission_dialog_message"
                        android:visibility="gone"
                        android:layout_width="@dimen/com_hive_sdk_permission_popup_inner_width"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/com_hive_sdk_default_popup_message_top_margin"
                        android:layout_marginBottom="@dimen/com_hive_sdk_default_popup_message_bottom_margin"
                        android:text="@string/hive_permission_common_desc"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/hive_permission_dialog_title"/>
                </LinearLayout>
            </com.hive.ui.view.MaxHeightScrollView>
            <RelativeLayout
                android:id="@+id/popup_button_area_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/com_hive_sdk_default_popup_button_area_horizontal_margin"
                android:layout_marginTop="@dimen/com_hive_sdk_default_popup_button_area_vertical_margin"
                android:layout_marginRight="@dimen/com_hive_sdk_default_popup_button_area_horizontal_margin"
                android:layout_marginBottom="@dimen/com_hive_sdk_default_popup_button_area_vertical_margin_bottom"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/hive_permission_scroll_view">
                <FrameLayout
                    android:id="@+id/popup_button_main_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentStart="true">
                    <TextView
                        android:textSize="@dimen/com_hive_sdk_default_popup_btn_text_size"
                        android:textStyle="normal"
                        android:textColor="?attr/commonWhite"
                        android:gravity="center"
                        android:id="@+id/hive_permission_dialog_main_button"
                        android:background="?attr/hiveDefaultPopupMainButton"
                        android:layout_width="@dimen/com_hive_sdk_permission_popup_btn_width"
                        android:layout_height="@dimen/com_hive_sdk_default_popup_btn_height"
                        android:text="@string/hive_permission_ui_ok"
                        android:lineSpacingExtra="2sp"/>
                </FrameLayout>
            </RelativeLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</RelativeLayout>
