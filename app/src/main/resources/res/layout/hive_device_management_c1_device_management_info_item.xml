<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/hiveDeviceManagementColorDivider"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingTop="@dimen/hive_device_management_size_16"
        android:paddingBottom="@dimen/hive_device_management_size_16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/hive_device_management_size_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/hive_device_management_device_management_info_item_edit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/hive_device_management_device_management_info_item_icon_connection"
            android:visibility="gone"
            android:layout_width="@dimen/hive_device_management_size_16"
            android:layout_height="@dimen/hive_device_management_size_16"
            android:layout_margin="@dimen/hive_device_management_size_4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="?attr/hiveIconConnection"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/hive_device_management_font_size_16"
            android:textStyle="normal"
            android:textColor="?attr/fontPopupMain"
            android:gravity="left"
            android:id="@+id/hive_device_management_device_management_info_item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2sp"
            android:layout_marginStart="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/hive_device_management_device_management_info_item_icon_connection"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginStart="0dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/hive_device_management_font_size_14"
            android:textStyle="normal"
            android:textColor="?attr/fontPopupSub"
            android:gravity="left"
            android:id="@+id/hive_device_management_device_management_info_item_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hive_device_management_153_2"
            android:lineSpacingExtra="2sp"
            app:layout_constraintStart_toStartOf="@+id/hive_device_management_device_management_info_item_title"
            app:layout_constraintTop_toBottomOf="@+id/hive_device_management_device_management_info_item_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/hive_device_management_device_management_info_item_edit"
        android:padding="@dimen/hive_device_management_size_20"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/hive_device_management_device_management_info_item_divider_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/hiveIconEdit"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/hive_device_management_device_management_info_item_divider_vertical"
        android:layout_width="1dp"
        android:layout_height="@dimen/hive_device_management_size_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/hive_device_management_device_management_info_item_delete"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/hiveDeviceManagementColorDivider"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/hive_device_management_device_management_info_item_delete"
        android:paddingTop="@dimen/hive_device_management_size_20"
        android:paddingBottom="@dimen/hive_device_management_size_20"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/hive_device_management_size_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/hiveIconDeleteActive"/>
</androidx.constraintlayout.widget.ConstraintLayout>
