<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipToPadding="false"
    android:layout_width="@dimen/com_hive_sdk_repayment_rectangle_2_item_width"
    android:layout_height="@dimen/com_hive_sdk_repayment_rectangle_2_item_height"
    android:layout_marginTop="@dimen/com_hive_sdk_repayment_rectangle_2_item_margin_top"
    android:layout_marginBottom="@dimen/com_hive_sdk_repayment_rectangle_2_item_margin_bottom"
    android:layoutDirection="ltr"
    android:layout_marginStart="@dimen/com_hive_sdk_repayment_rectangle_2_item_margin_left"
    android:layout_marginEnd="@dimen/com_hive_sdk_repayment_rectangle_2_item_margin_right">
    <TextView
        android:textSize="@dimen/com_hive_sdk_repayment_rectangle_2_item_font"
        android:textStyle="normal"
        android:textColor="?attr/fontPopupMain"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/hive_repayment_rectangle_2_item_title"
        android:layout_width="@dimen/com_hive_sdk_repayment_rectangle_2_item_title_width"
        android:layout_height="@dimen/com_hive_sdk_repayment_rectangle_2_item_title_height"
        android:maxLines="2"
        android:lineSpacingExtra="2sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/com_hive_sdk_repayment_rectangle_2_item_font"
        android:textStyle="normal"
        android:textColor="?attr/fontPopupSub"
        android:ellipsize="marquee"
        android:gravity="left"
        android:id="@+id/hive_repayment_rectangle_2_item_refund_time"
        android:layout_width="@dimen/com_hive_sdk_repayment_rectangle_2_item_title_width"
        android:layout_height="@dimen/com_hive_sdk_repayment_rectangle_2_item_refund_time_height"
        android:singleLine="true"
        android:lineSpacingExtra="2sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hive_repayment_rectangle_2_item_title"/>
    <TextView
        android:textSize="@dimen/com_hive_sdk_repayment_rectangle_2_item_button_font"
        android:textStyle="normal"
        android:textColor="?attr/commonWhite"
        android:gravity="center"
        android:id="@+id/hive_repayment_rectangle_2_item_button"
        android:background="?attr/hiveDefaultPopupMainButton"
        android:layout_width="0dp"
        android:layout_height="@dimen/com_hive_sdk_repayment_rectangle_2_item_height"
        android:lineSpacingExtra="2sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/hive_repayment_rectangle_2_item_title"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
