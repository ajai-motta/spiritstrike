<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.hive.ui.view.HiveTextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/fontPopupMain"
        android:gravity="left"
        android:id="@+id/titleTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/hive_promotion_custom_review_title"
        app:layout_constraintBottom_toTopOf="@+id/bodyTextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:syncLineHeight="28sp"/>
    <com.hive.ui.view.HiveTextView
        android:textSize="16sp"
        android:textColor="?attr/hivePromotionCustomReviewBodyTextColor"
        android:gravity="left"
        android:id="@+id/bodyTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/hive_promotion_custom_review_body"
        app:layout_constraintBottom_toTopOf="@+id/buttonLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleTextView"
        app:syncLineHeight="22sp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/buttonLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layoutDirection="ltr"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bodyTextView">
        <Space
            android:id="@+id/buttonSpace"
            android:layout_width="14dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.hive.ui.view.HiveTextView
            android:textSize="16sp"
            android:textColor="?attr/hivePromotionCustomReviewLeftButtonTextColor"
            android:gravity="center"
            android:id="@+id/leftButton"
            android:background="?attr/hivePromotionCustomReviewLeftButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:text="@string/hive_promotion_custom_review_button_left"
            android:maxLines="2"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/buttonSpace"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:syncLineHeight="18sp"/>
        <com.hive.ui.view.HiveTextView
            android:textSize="16sp"
            android:textColor="@color/hiveCommonWhite"
            android:gravity="center"
            android:id="@+id/rightButton"
            android:background="?attr/hivePromotionCustomReviewRightButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:text="@string/hive_promotion_custom_review_button_right"
            android:maxLines="2"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/buttonSpace"
            app:layout_constraintTop_toTopOf="parent"
            app:syncLineHeight="18sp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
