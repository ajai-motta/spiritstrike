<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/com_hive_sdk_permission_content_text_size"
        android:textColor="?attr/fontPopupSub"
        android:gravity="left"
        android:id="@+id/hive_permission_string_text_view"
        android:layout_width="@dimen/com_hive_sdk_permission_scroll_text_width"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/com_hive_sdk_permission_content_margin"
        android:text="STORAGE(Optional) - The authority is required to use an external memory storage for additional downloads."
        android:lineSpacingMultiplier="1.1"
        android:fontFamily="sans-serif"/>
</LinearLayout>
