<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/bgColor"
    android:paddingLeft="@dimen/hive_device_management_size_30"
    android:paddingTop="@dimen/hive_device_management_size_20"
    android:paddingRight="@dimen/hive_device_management_size_30"
    android:paddingBottom="@dimen/hive_device_management_size_20"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:paddingHorizontal="@dimen/hive_device_management_size_30"
    android:paddingVertical="@dimen/hive_device_management_size_20">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/hive_device_management_main"
        android:background="?attr/hiveDefaultPopupBackground"
        android:padding="@dimen/hive_device_management_size_20"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/hive_device_management_width_max">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/hive_device_management_font_size_20"
            android:textStyle="bold"
            android:textColor="?attr/fontPopupMain"
            android:gravity="left"
            android:id="@+id/hive_device_management_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hive_device_management_112"
            android:lineSpacingExtra="2sp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="@dimen/hive_device_management_button_close_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.core.widget.NestedScrollView
            android:scrollbarSize="3dp"
            android:scrollbarThumbVertical="?attr/hiveDefaultPopupScrollbar"
            android:scrollbarStyle="outsideInset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hive_device_management_size_10"
            android:layout_marginBottom="@dimen/hive_device_management_size_20"
            android:fadeScrollbars="true"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@+id/hive_device_management_active_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hive_device_management_title">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/hive_device_management_font_size_16"
                    android:textStyle="normal"
                    android:textColor="?attr/fontPopupSub"
                    android:gravity="left"
                    android:layout_gravity="start"
                    android:id="@+id/hive_device_management_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/hive_device_management_size_20"
                    android:text="@string/hive_device_management_114"
                    android:lineSpacingExtra="2sp"
                    app:layout_constraintBottom_toTopOf="@+id/hive_device_management_phone_number"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/hive_device_management_font_size_18"
                    android:textStyle="normal"
                    android:textColor="?attr/fontPopupMain"
                    android:gravity="center"
                    android:layout_gravity="start"
                    android:id="@+id/hive_device_management_phone_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/hive_device_management_size_10"
                    android:lineSpacingExtra="2sp"
                    app:layout_constraintBottom_toTopOf="@+id/hive_device_management_time_limit"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/hive_device_management_content"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/hive_device_management_font_size_14"
                    android:textColor="?attr/hiveDeviceManagementFontColorErrorMessage"
                    android:gravity="left"
                    android:id="@+id/hive_device_management_time_limit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="@dimen/hive_device_management_size_4"
                    android:lineSpacingExtra="2sp"
                    android:layout_marginHorizontal="10dp"
                    app:layout_constrainedHeight="true"
                    app:layout_constraintBottom_toTopOf="@+id/hive_device_management_button_input"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/hive_device_management_phone_number"/>
                <androidx.appcompat.widget.AppCompatEditText
                    android:textSize="@dimen/hive_device_management_font_size_16"
                    android:textStyle="normal"
                    android:textColor="?attr/fontPopupMain"
                    android:textColorHint="?attr/hiveFontColorInputDefault"
                    android:gravity="center"
                    android:id="@+id/hive_device_management_button_input"
                    android:background="?attr/hiveButtonInput"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hive_device_management_button_height"
                    android:layout_marginBottom="@dimen/hive_device_management_size_4"
                    android:hint="@string/hive_device_management_146"
                    android:maxLength="6"
                    android:inputType="number"
                    android:imeOptions="flagNoExtractUi"
                    android:paddingHorizontal="20dp"
                    app:layout_constraintBottom_toTopOf="@+id/hive_device_management_error_message"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/hive_device_management_time_limit"
                    app:layout_goneMarginBottom="@dimen/hive_device_management_size_20"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/hive_device_management_font_size_14"
                    android:textColor="?attr/hiveDeviceManagementActiveResendFontColor"
                    android:gravity="center"
                    android:id="@+id/hive_device_management_btn_resend"
                    android:padding="@dimen/hive_device_management_size_10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/hive_device_management_size_10"
                    android:layout_marginRight="@dimen/hive_device_management_size_10"
                    android:text="@string/hive_device_management_116"
                    android:layout_marginHorizontal="@dimen/hive_device_management_size_10"
                    app:layout_constraintBottom_toBottomOf="@+id/hive_device_management_button_input"
                    app:layout_constraintEnd_toEndOf="@+id/hive_device_management_button_input"
                    app:layout_constraintTop_toTopOf="@+id/hive_device_management_button_input"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/hive_device_management_font_size_12"
                    android:textColor="?attr/hiveDeviceManagementFontColorErrorMessage"
                    android:gravity="left"
                    android:id="@+id/hive_device_management_error_message"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="@dimen/hive_device_management_size_20"
                    android:text="@string/hive_device_management_120"
                    android:lineSpacingExtra="2sp"
                    android:layout_marginHorizontal="10dp"
                    app:layout_constrainedHeight="true"
                    app:layout_constraintBottom_toTopOf="@+id/hive_device_management_sub_info_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/hive_device_management_button_input"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/hive_device_management_oval_1"
                    android:layout_width="@dimen/hive_device_management_size_4"
                    android:layout_height="@dimen/hive_device_management_size_4"
                    android:layout_marginTop="@dimen/hive_device_management_size_6"
                    android:layout_marginEnd="@dimen/hive_device_management_size_6"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/hive_device_management_sub_info_title"
                    app:srcCompat="?attr/hiveIconOval_cookie"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/hive_device_management_font_size_12"
                    android:textColor="?attr/fontPopupMain"
                    android:gravity="left"
                    android:id="@+id/hive_device_management_sub_info_title"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/hive_device_management_size_4"
                    android:text="@string/hive_device_management_118"
                    android:lineSpacingExtra="2sp"
                    android:layout_marginStart="@dimen/hive_device_management_size_4"
                    app:layout_constrainedHeight="true"
                    app:layout_constraintBottom_toTopOf="@+id/hive_device_management_sub_info_content"
                    app:layout_constraintStart_toEndOf="@+id/hive_device_management_oval_1"
                    app:layout_constraintTop_toBottomOf="@+id/hive_device_management_error_message"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/hive_device_management_font_size_12"
                    android:textColor="?attr/fontPopupSub"
                    android:gravity="left"
                    android:id="@+id/hive_device_management_sub_info_content"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/hive_device_management_size_4"
                    android:text="@string/hive_device_management_119"
                    android:lineSpacingExtra="2sp"
                    app:layout_constrainedHeight="true"
                    app:layout_constraintBottom_toTopOf="@+id/hive_device_management_contact_customer_support"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/hive_device_management_sub_info_title"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/hive_device_management_font_size_12"
                    android:textColor="?attr/hiveHyperLinkFontColor"
                    android:gravity="left"
                    android:id="@+id/hive_device_management_contact_customer_support"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hive_device_management_157"
                    android:lineSpacingExtra="2sp"
                    app:layout_constrainedHeight="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/hive_device_management_sub_info_content"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/hive_device_management_font_size_16"
            android:textStyle="normal"
            android:textColor="?attr/commonWhite"
            android:gravity="center"
            android:id="@+id/hive_device_management_cancel_button"
            android:background="?attr/hiveDefaultPopupSubButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/hive_device_management_button_height"
            android:text="@string/hive_device_management_99"
            android:lineSpacingExtra="2sp"
            android:layout_marginEnd="@dimen/hive_device_management_size_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/hive_device_management_active_button"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:enabled="false"
            android:textSize="@dimen/hive_device_management_font_size_16"
            android:textStyle="normal"
            android:textColor="?attr/hiveDeviceManagementFontColorInActive"
            android:gravity="center"
            android:id="@+id/hive_device_management_active_button"
            android:background="?attr/hiveDeviceManagementButtonInActive"
            android:layout_width="0dp"
            android:layout_height="@dimen/hive_device_management_button_height"
            android:text="@string/hive_device_management_117"
            android:lineSpacingExtra="2sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/hive_device_management_cancel_button"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/hive_device_management_button_close"
        android:padding="@dimen/hive_device_management_size_10"
        android:layout_width="@dimen/hive_device_management_button_close_size"
        android:layout_height="@dimen/hive_device_management_button_close_size"
        app:layout_constraintEnd_toEndOf="@+id/hive_device_management_main"
        app:layout_constraintTop_toTopOf="@+id/hive_device_management_main"
        app:srcCompat="?attr/hiveButtonClose"/>
</androidx.constraintlayout.widget.ConstraintLayout>
