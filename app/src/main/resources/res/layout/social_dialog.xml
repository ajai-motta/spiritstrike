<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/social_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/social_DialogTopBar"
        android:background="#303030"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr">
        <androidx.appcompat.widget.AppCompatImageView
            android:gravity="center_vertical"
            android:id="@+id/social_BackToGameArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:contentDescription="BackToGameArrow"
            android:layout_marginEnd="10dp"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/social_hive_arrow_btn"/>
        <TextView
            android:textSize="16dp"
            android:textColor="#ffffffff"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/social_BackToGame"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:text="@string/hive_social_back_to_game"
            android:layout_toLeftOf="@+id/social_BackToGameArrow"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/social_BackToGameArrow"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_gravity="fill"
        android:id="@+id/social_DialogBottomWebview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.hive.core.webview.HiveWebView
            android:id="@+id/social_HiveWebview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ProgressBar
            android:id="@+id/social_HiveSpinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</LinearLayout>
