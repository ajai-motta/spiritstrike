<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <com.hive.core.webview.HiveWebView
        android:id="@+id/hive_identity_verification_webview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.hive.ui.view.HiveAnimationButton
        android:id="@+id/hive_identity_verification_goback_btn"
        android:visibility="invisible"
        android:layout_width="@dimen/authv4_identity_verification_dialog_close_btn_size"
        android:layout_height="@dimen/authv4_identity_verification_dialog_close_btn_size"
        android:layout_marginLeft="@dimen/authv4_identity_verification_dialog_close_btn_margin"
        android:layout_marginTop="@dimen/authv4_identity_verification_dialog_close_btn_margin"
        android:layout_marginStart="@dimen/authv4_identity_verification_dialog_close_btn_margin"
        app:OffAnimation="@drawable/authv4_identity_verification_goback_btn_down"
        app:OnAnimation="@drawable/authv4_identity_verification_goback_btn_up"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/authv4_identity_verification_goback_btn_up"/>
    <com.hive.ui.view.HiveAnimationButton
        android:id="@+id/hive_identity_verification_goback_deactive_btn"
        android:layout_width="@dimen/authv4_identity_verification_dialog_close_btn_size"
        android:layout_height="@dimen/authv4_identity_verification_dialog_close_btn_size"
        android:layout_marginLeft="@dimen/authv4_identity_verification_dialog_close_btn_margin"
        android:layout_marginTop="@dimen/authv4_identity_verification_dialog_close_btn_margin"
        android:layout_marginStart="@dimen/authv4_identity_verification_dialog_close_btn_margin"
        app:OffAnimation="@drawable/authv4_identity_verification_goback_deactive_btn_down"
        app:OnAnimation="@drawable/authv4_identity_verification_goback_deactive_btn_up"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/authv4_identity_verification_goback_deactive_btn_up"/>
    <com.hive.ui.view.HiveAnimationButton
        android:id="@+id/hive_identity_verification_close_btn"
        android:layout_width="@dimen/authv4_identity_verification_dialog_close_btn_size"
        android:layout_height="@dimen/authv4_identity_verification_dialog_close_btn_size"
        android:layout_marginTop="@dimen/authv4_identity_verification_dialog_close_btn_margin"
        android:layout_marginRight="@dimen/authv4_identity_verification_dialog_close_btn_margin"
        android:layout_marginEnd="@dimen/authv4_identity_verification_dialog_close_btn_margin"
        app:OffAnimation="@drawable/authv4_identity_verification_close_btn_down"
        app:OnAnimation="@drawable/authv4_identity_verification_close_btn_up"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/authv4_identity_verification_close_btn_up"/>
    <androidx.core.widget.ContentLoadingProgressBar
        android:id="@+id/hive_identity_verification_webview_spinner"
        android:layout_width="@dimen/authv4_dialog_close_btn_size"
        android:layout_height="@dimen/authv4_dialog_close_btn_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?android:attr/progressBarStyleLarge"/>
</androidx.constraintlayout.widget.ConstraintLayout>
