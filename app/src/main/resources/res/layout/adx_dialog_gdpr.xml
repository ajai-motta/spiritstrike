<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/linearLayout"
        android:background="@drawable/adx_gdpr_header_background"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true">
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/adx_bi_for_android"/>
    </LinearLayout>
    <ScrollView
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/linearLayout">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="24dp"
            android:layout_centerHorizontal="true">
            <TextView
                android:textSize="20sp"
                android:textColor="#000000"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginBottom="10dp"
                android:text="Personalize Your Ad Experience"
                android:lineSpacingExtra="16sp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#000000"
                android:textColorLink="#ff5a4d"
                android:gravity="center_vertical"
                android:id="@+id/adx_textview_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This app personalizes your advertising experience using AD(X). AD(X) does not collect any data, but our partners may collect and process personal data such as device identifiers, location data, and other demographic and interest data to provide advertising experience tailored to you. By consenting to this improved ad experience, you&apos;ll see ads that AD(X) and its partners believe are more relevant to you. Learn more."
                android:lineSpacingExtra="8sp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#000000"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="By agreeing, you confirm that you are over the age of 16 and would like a personalized ad experience."
                android:lineSpacingExtra="8sp"/>
            <Button
                android:textSize="18sp"
                android:textColor="#ffffff"
                android:id="@+id/adx_btn_ok"
                android:background="@drawable/adx_gdpr_btn_ok"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:text="Yes, I agree"
                android:lineSpacingExtra="6sp"/>
            <Button
                android:textSize="18sp"
                android:textColor="#ffffff"
                android:id="@+id/adx_btn_cancel"
                android:background="@drawable/adx_gdpr_btn_cancel"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:text="No, Thanks"
                android:lineSpacingExtra="6sp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#777777"
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="I understand that I will still see ads, but they may not be as relevant to my interest."
                android:lineSpacingExtra="6sp"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/confirmLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="24dp"
        android:layout_below="@+id/linearLayout">
        <TextView
            android:textSize="20sp"
            android:textColor="#000000"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginBottom="10dp"
            android:text="Personalize Your Ad Experience"
            android:lineSpacingExtra="16sp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#000000"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Great. We hope you enjoy your personalized ad experience. If you ever change your mind, you can withdraw your consent by enabling Opt out of Ads Personalization under Settings/Google/Ads on your android device and then restarting this app."
            android:layout_weight="1"
            android:lineSpacingExtra="8sp"/>
        <Button
            android:textSize="18sp"
            android:textColor="#ffffff"
            android:id="@+id/adx_btn_close_window_confirm"
            android:background="@drawable/adx_gdpr_btn_cancel"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:text="Close this window"
            android:lineSpacingExtra="6sp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/denyLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="24dp"
        android:layout_below="@+id/linearLayout">
        <TextView
            android:textSize="20sp"
            android:textColor="#000000"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginBottom="10dp"
            android:text="Personalize Your Ad Experience"
            android:lineSpacingExtra="16sp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#000000"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AD(X) won’t collect your data for personalized advertising in this app. However, if you authorize AD(X) to personalize your advertising experience in a different app, we will collect your data in that other app."
            android:layout_weight="1"
            android:lineSpacingExtra="8sp"/>
        <Button
            android:textSize="18sp"
            android:textColor="#ffffff"
            android:id="@+id/adx_btn_close_window_deny"
            android:background="@drawable/adx_gdpr_btn_cancel"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:text="Close this window"
            android:lineSpacingExtra="6sp"/>
    </LinearLayout>
</RelativeLayout>
