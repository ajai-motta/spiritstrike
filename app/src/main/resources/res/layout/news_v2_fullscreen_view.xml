<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.hive.core.webview.HiveWebView
        android:id="@+id/webView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.hive.ui.view.HiveAnimationButton
        android:id="@+id/back_imageView"
        android:layout_width="@dimen/promotion_news_view_back_btn_size"
        android:layout_height="@dimen/promotion_news_view_back_btn_size"
        android:layout_marginLeft="@dimen/promotion_news_view_back_btn_margin"
        android:layout_marginBottom="@dimen/promotion_news_view_back_btn_margin"
        android:layout_marginStart="@dimen/promotion_news_view_back_btn_margin"
        app:OffAnimation="@drawable/promotion_news_fullscreen_back_btn_from_up_to_down"
        app:OnAnimation="@drawable/promotion_news_fullscreen_back_btn_from_down_to_up"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/promotion_news_fullscreen_back_btn_from_down_to_up"/>
    <com.hive.ui.view.HiveAnimationButton
        android:id="@+id/close_imageView"
        android:layout_width="@dimen/promotion_news_view_close_btn_size"
        android:layout_height="@dimen/promotion_news_view_close_btn_size"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginEnd="10dp"
        app:OffAnimation="@drawable/promotion_news_fullscreen_close_from_up_to_down"
        app:OnAnimation="@drawable/promotion_news_fullscreen_close_from_down_to_up"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/promotion_news_fullscreen_close_from_down_to_up"/>
</androidx.constraintlayout.widget.ConstraintLayout>
