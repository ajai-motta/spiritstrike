<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/promotion_customview_v2_root"
    android:background="#00000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="1000">
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/com_hive_sdk_promotion_customview_v2_banner_vertical_margin"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:weightSum="1000"
            android:layout_weight="@integer/com_hive_sdk_promotion_customview_v2_banner_height">
            <View
                android:layout_width="@dimen/com_hive_sdk_promotion_customview_v2_banner_horizontal_margin"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/promotion_customview_v2_bg"
                android:background="@drawable/promotion_customview_rounded_shape"
                android:padding="3dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:weightSum="100"
                android:layout_weight="@integer/com_hive_sdk_promotion_customview_v2_banner_width">
                <com.hive.promotion.PromotionCustomViewRoundedCorner
                    android:background="#00000000"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="#00000000"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:weightSum="1000">
                        <com.hive.core.webview.HiveWebView
                            android:id="@+id/promotion_customview_v2_webview"
                            android:background="#cc000000"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="@integer/com_hive_sdk_promotion_customview_v2_banner_webview_height"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/promotion_customview_v2_bottom"
                            android:background="#2683d8"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/com_hive_sdk_promotion_customview_v2_banner_bottom_height"
                            android:weightSum="100">
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="@integer/com_hive_sdk_promotion_customview_v2_banner_bottom_vertical_margin"/>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:weightSum="1000"
                                android:layout_weight="@integer/com_hive_sdk_promotion_customview_v2_banner_bottom_button_height">
                                <View
                                    android:layout_width="@dimen/com_hive_sdk_promotion_customview_v2_banner_button_horizontal_margin"
                                    android:layout_height="match_parent"/>
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_gravity="center"
                                    android:id="@+id/promotion_customview_v2_btn_prev"
                                    android:background="#00000000"
                                    android:layout_width="@dimen/com_hive_sdk_promotion_customview_v2_banner_button_width"
                                    android:layout_height="match_parent"/>
                                <View
                                    android:layout_width="@dimen/com_hive_sdk_promotion_customview_v2_banner_button_margin"
                                    android:layout_height="match_parent"/>
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_gravity="center"
                                    android:id="@+id/promotion_customview_v2_btn_next"
                                    android:background="#00000000"
                                    android:layout_width="@dimen/com_hive_sdk_promotion_customview_v2_banner_button_width"
                                    android:layout_height="match_parent"/>
                                <View
                                    android:layout_width="@dimen/com_hive_sdk_promotion_customview_v2_banner_button_margin"
                                    android:layout_height="match_parent"/>
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_gravity="center"
                                    android:id="@+id/promotion_customview_v2_btn_refresh"
                                    android:background="#00000000"
                                    android:layout_width="@dimen/com_hive_sdk_promotion_customview_v2_banner_button_width"
                                    android:layout_height="match_parent"/>
                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="@integer/com_hive_sdk_promotion_customview_v2_banner_button_center_space"/>
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_gravity="center"
                                    android:id="@+id/promotion_customview_v2_btn_close"
                                    android:background="#00000000"
                                    android:layout_width="@dimen/com_hive_sdk_promotion_customview_v2_banner_button_width"
                                    android:layout_height="match_parent"/>
                                <View
                                    android:layout_width="@dimen/com_hive_sdk_promotion_customview_v2_banner_button_horizontal_margin"
                                    android:layout_height="match_parent"/>
                            </LinearLayout>
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="@integer/com_hive_sdk_promotion_customview_v2_banner_bottom_vertical_margin"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.hive.promotion.PromotionCustomViewRoundedCorner>
            </LinearLayout>
            <View
                android:layout_width="@dimen/com_hive_sdk_promotion_customview_v2_banner_horizontal_margin"
                android:layout_height="match_parent"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/com_hive_sdk_promotion_customview_v2_banner_vertical_margin"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="1000">
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/com_hive_sdk_promotion_customview_v2_banner_vertical_margin"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:weightSum="1000"
            android:layout_weight="@integer/com_hive_sdk_promotion_customview_v2_banner_height">
            <View
                android:layout_width="@dimen/com_hive_sdk_promotion_customview_v2_banner_horizontal_margin"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:weightSum="1000"
                android:layout_weight="@integer/com_hive_sdk_promotion_customview_v2_banner_width">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="@integer/com_hive_sdk_promotion_customview_v2_banner_progress_bar_top_margin"/>
                <ProgressBar
                    android:id="@+id/promotion_customview_v2_loadingbar"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/hive_progress_bar"
                    style="?android:attr/progressBarStyleHorizontal"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="@integer/com_hive_sdk_promotion_customview_v2_banner_progress_bar_bottom_margin"/>
            </LinearLayout>
            <View
                android:layout_width="@dimen/com_hive_sdk_promotion_customview_v2_banner_horizontal_margin"
                android:layout_height="match_parent"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/com_hive_sdk_promotion_customview_v2_banner_vertical_margin"/>
    </LinearLayout>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/promotion_view_spinner"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
