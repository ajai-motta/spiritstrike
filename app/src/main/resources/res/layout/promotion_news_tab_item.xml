<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tabItem_layout"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/tabItem_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/newsTabBackground"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/tabItem_overlay_background"
        android:padding="1dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/promotion_news_tab_item_overlay_background"/>
    <Space
        android:id="@+id/tabItem_icon_marginTop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="@dimen/promotion_news_tab_item_marginTop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="@dimen/promotion_news_tab_item_content_size"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabItem_icon_marginTop">
        <Space
            android:id="@+id/tabItem_icon_marginStart"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="@string/promotion_news_tab_icon_marginStart_ratio"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/tabItem_icon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintHeight_default="percent"
            app:layout_constraintHeight_percent="@dimen/promotion_news_tab_item_icon_size"
            app:layout_constraintStart_toEndOf="@+id/tabItem_icon_marginStart"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/promotion_news_tab_item_default_icon"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tabItem_textView_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tabItem_icon"
            app:layout_constraintTop_toTopOf="parent">
            <Space
                android:id="@+id/tabItem_icon_marginEnd"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="@string/promotion_news_tab_icon_marginEnd_ratio"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textStyle="bold"
                android:textColor="?attr/newsOffColor"
                android:gravity="center_vertical"
                android:id="@+id/tabItem_textView"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:text="@string/hive_promotion_news_tab_item"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tabItem_icon_marginEnd"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/tabItem_badge"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintHeight_percent="@dimen/promotion_news_tab_item_badge_size"
            app:layout_constraintStart_toEndOf="@+id/tabItem_textView_layout"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/promotion_news_v2_badge"/>
        <Space
            android:id="@+id/tabItem_textView_layout_marginEnd"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="@string/promotion_news_tab_item_textView_marginEnd_ratio"
            app:layout_constraintStart_toEndOf="@+id/tabItem_textView_layout"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
