<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/news_frameView_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Space
        android:id="@+id/content_marginTop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="@dimen/promotion_news_banner_frame_view_margin_top_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/content_marginBottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="@dimen/promotion_news_banner_frame_view_margin_top_bottom"
        app:layout_constraintStart_toStartOf="parent"/>
    <Space
        android:id="@+id/content_marginStart"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="@dimen/promotion_news_banner_frame_view_margin_start_end"/>
    <Space
        android:id="@+id/content_marginEnd"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="@dimen/promotion_news_banner_frame_view_margin_start_end"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/content_marginBottom"
        app:layout_constraintEnd_toStartOf="@+id/content_marginEnd"
        app:layout_constraintStart_toEndOf="@+id/content_marginStart"
        app:layout_constraintTop_toBottomOf="@+id/content_marginTop">
        <com.hive.promotion.ui.RoundedCornerView
            android:id="@+id/rounded_corner"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:round="10dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.hive.core.webview.HiveWebView
                    android:id="@+id/webView"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.hive.ui.view.HiveAnimationButton
                    android:id="@+id/back_imageView"
                    android:layout_width="@dimen/promotion_news_view_back_btn_size"
                    android:layout_height="@dimen/promotion_news_view_back_btn_size"
                    android:layout_marginLeft="@dimen/promotion_news_view_back_btn_margin"
                    android:layout_marginBottom="@dimen/promotion_news_view_back_btn_margin"
                    android:layout_marginStart="@dimen/promotion_news_view_back_btn_margin"
                    app:OffAnimation="@drawable/promotion_news_fullscreen_back_btn_from_up_to_down"
                    app:OnAnimation="@drawable/promotion_news_fullscreen_back_btn_from_down_to_up"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:srcCompat="@drawable/promotion_news_fullscreen_back_btn_from_down_to_up"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.hive.promotion.ui.RoundedCornerView>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentLayout_bottom"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_default="percent"
            app:layout_constraintHeight_percent="@dimen/promotion_news_banner_frame_view_bottom_content_height_percent"
            app:layout_constraintStart_toStartOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="fitXY"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/promotion_news_v2_frame_bottom"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/forceLayout"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <Space
                    android:id="@+id/forceBtn_marginStart"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="@string/promotion_news_frame_view_force_btn_marginStart"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/forceBtn"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintHeight_default="percent"
                    app:layout_constraintHeight_percent="@dimen/promotion_news_frame_view_force_btn_size"
                    app:layout_constraintStart_toEndOf="@+id/forceBtn_marginStart"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/promotion_news_force_from_off_to_on"/>
                <Space
                    android:id="@+id/forceTextView_marginStart"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="@string/promotion_news_frame_view_force_textView_marginStart"
                    app:layout_constraintStart_toEndOf="@+id/forceBtn"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textColor="?attr/newsOffColor"
                    android:gravity="center_vertical"
                    android:id="@+id/forceTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:text="@string/hive_promotion_style_banner"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/forceTextView_marginStart"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
