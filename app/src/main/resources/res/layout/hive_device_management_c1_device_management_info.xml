<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/bgColor"
    android:paddingLeft="@dimen/hive_device_management_size_30"
    android:paddingTop="@dimen/hive_device_management_size_20"
    android:paddingRight="@dimen/hive_device_management_size_30"
    android:paddingBottom="@dimen/hive_device_management_size_20"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:paddingHorizontal="@dimen/hive_device_management_size_30"
    android:paddingVertical="@dimen/hive_device_management_size_20">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/hive_device_management_main"
        android:background="?attr/hiveDefaultPopupBackground"
        android:padding="@dimen/hive_device_management_size_20"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/hive_device_management_width_max">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/hive_device_management_font_size_20"
            android:textStyle="bold"
            android:textColor="?attr/fontPopupMain"
            android:gravity="left"
            android:id="@+id/hive_device_management_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hive_device_management_91"
            android:lineSpacingExtra="2sp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="@dimen/hive_device_management_button_close_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.core.widget.NestedScrollView
            android:scrollbarSize="3dp"
            android:scrollbarThumbVertical="?attr/hiveDefaultPopupScrollbar"
            android:scrollbarStyle="outsideInset"
            android:id="@+id/hive_device_management_device_management_info_device_list_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hive_device_management_size_10"
            android:layout_marginBottom="@dimen/hive_device_management_size_30"
            android:fadeScrollbars="true"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@+id/hive_device_management_active_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hive_device_management_title">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/hive_device_management_device_management_info_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toTopOf="@+id/hive_device_management_bottom_bar"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/hive_device_management_bottom_bar"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="@dimen/hive_device_management_size_20"
                    app:layout_constraintBottom_toTopOf="@+id/hive_device_management_text_1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/hive_device_management_device_management_info_recycler_view"
                    app:srcCompat="?attr/hiveDeviceManagementColorDivider"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/hive_device_management_oval_1"
                    android:layout_width="@dimen/hive_device_management_size_4"
                    android:layout_height="@dimen/hive_device_management_size_4"
                    android:layout_marginTop="@dimen/hive_device_management_size_6"
                    android:layout_marginEnd="@dimen/hive_device_management_size_6"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/hive_device_management_text_1"
                    app:srcCompat="?attr/hiveIconOval"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/hive_device_management_font_size_12"
                    android:textStyle="normal"
                    android:textColor="?attr/fontPopupSub"
                    android:gravity="left"
                    android:layout_gravity="start"
                    android:id="@+id/hive_device_management_text_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/hive_device_management_95"
                    android:lineSpacingExtra="2sp"
                    android:layout_marginStart="@dimen/hive_device_management_size_4"
                    app:layout_constraintBottom_toTopOf="@+id/hive_device_management_text_2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/hive_device_management_oval_1"
                    app:layout_constraintTop_toBottomOf="@+id/hive_device_management_bottom_bar"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/hive_device_management_oval_2"
                    android:layout_width="@dimen/hive_device_management_size_4"
                    android:layout_height="@dimen/hive_device_management_size_4"
                    android:layout_marginTop="@dimen/hive_device_management_size_6"
                    android:layout_marginEnd="@dimen/hive_device_management_size_6"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/hive_device_management_text_2"
                    app:srcCompat="?attr/hiveIconOval"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/hive_device_management_font_size_12"
                    android:textStyle="normal"
                    android:textColor="?attr/fontPopupSub"
                    android:gravity="left"
                    android:layout_gravity="start"
                    android:id="@+id/hive_device_management_text_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/hive_device_management_96"
                    android:lineSpacingExtra="2sp"
                    android:layout_marginStart="@dimen/hive_device_management_size_4"
                    app:layout_constraintBottom_toTopOf="@+id/hive_device_management_text_3"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/hive_device_management_oval_2"
                    app:layout_constraintTop_toBottomOf="@+id/hive_device_management_text_1"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/hive_device_management_oval_3"
                    android:layout_width="@dimen/hive_device_management_size_4"
                    android:layout_height="@dimen/hive_device_management_size_4"
                    android:layout_marginTop="@dimen/hive_device_management_size_6"
                    android:layout_marginEnd="@dimen/hive_device_management_size_6"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/hive_device_management_text_3"
                    app:srcCompat="?attr/hiveIconOval"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/hive_device_management_font_size_12"
                    android:textStyle="normal"
                    android:textColor="?attr/fontPopupSub"
                    android:gravity="left"
                    android:layout_gravity="start"
                    android:id="@+id/hive_device_management_text_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/hive_device_management_97"
                    android:lineSpacingExtra="2sp"
                    android:layout_marginStart="@dimen/hive_device_management_size_4"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/hive_device_management_oval_3"
                    app:layout_constraintTop_toBottomOf="@+id/hive_device_management_text_2"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/hive_device_management_font_size_16"
            android:textStyle="normal"
            android:textColor="?attr/commonWhite"
            android:gravity="center"
            android:id="@+id/hive_device_management_cancel_button"
            android:background="?attr/hiveDefaultPopupSubButton"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/hive_device_management_button_height"
            android:text="@string/hive_device_management_93"
            android:lineSpacingExtra="2sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hive_device_management_active_button"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/hive_device_management_font_size_16"
            android:textStyle="normal"
            android:textColor="?attr/hiveDeviceManagementFontColorActive"
            android:gravity="center"
            android:id="@+id/hive_device_management_active_button"
            android:background="?attr/hiveDeviceManagementButtonActive"
            android:layout_width="match_parent"
            android:layout_height="@dimen/hive_device_management_button_height"
            android:layout_marginBottom="@dimen/hive_device_management_size_10"
            android:text="@string/hive_device_management_112"
            android:lineSpacingExtra="2sp"
            app:layout_constraintBottom_toTopOf="@+id/hive_device_management_cancel_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hive_device_management_device_management_info_device_list_layout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/hive_device_management_button_close"
        android:padding="@dimen/hive_device_management_size_10"
        android:layout_width="@dimen/hive_device_management_button_close_size"
        android:layout_height="@dimen/hive_device_management_button_close_size"
        app:layout_constraintEnd_toEndOf="@+id/hive_device_management_main"
        app:layout_constraintTop_toTopOf="@+id/hive_device_management_main"
        app:srcCompat="?attr/hiveButtonClose"/>
</androidx.constraintlayout.widget.ConstraintLayout>
