<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bannerItem_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Space
        android:id="@+id/promotion_news_banner_item_imageView_marginStart"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="@dimen/promotion_news_banner_item_margin"/>
    <Space
        android:id="@+id/promotion_news_banner_item_imageView_marginEnd"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="@dimen/promotion_news_banner_item_margin"/>
    <Space
        android:id="@+id/promotion_news_banner_item_imageView_marginBottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="@string/promotion_news_banner_item_margin_bottom_ratio"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.hive.promotion.ui.RoundedCornerView
        android:id="@+id/promotion_news_banner_item_imageView_round"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/promotion_news_banner_item_imageView_marginBottom"
        app:layout_constraintEnd_toStartOf="@+id/promotion_news_banner_item_imageView_marginEnd"
        app:layout_constraintStart_toEndOf="@+id/promotion_news_banner_item_imageView_marginStart"
        app:layout_constraintTop_toTopOf="parent"
        app:round="10dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/promotion_news_banner_item_imageView"
            android:background="#00000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"/>
    </com.hive.promotion.ui.RoundedCornerView>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/promotion_news_banner_item_gift_imageView"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="@dimen/promotion_news_banner_item_gift_imageView_width_percent"
        app:srcCompat="@drawable/promotion_news_v2_gift_icon"/>
    <Space
        android:id="@+id/promotion_news_banner_badge_marginLeft"
        android:background="#ff0000"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="@dimen/promotion_news_banner_item_badge_margin_left_percent"/>
    <Space
        android:id="@+id/promotion_news_banner_badge_marginBottom"
        android:background="#000000"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="@string/promotion_news_banner_item_badge_margin_bottom_ratio"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/promotion_news_banner_item_badge_layout"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        app:layout_constraintBottom_toTopOf="@+id/promotion_news_banner_badge_marginBottom"
        app:layout_constraintStart_toEndOf="@+id/promotion_news_banner_badge_marginLeft">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/promotion_news_banner_item_badge_layout_background"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/promotion_news_banner_badge_border"/>
        <Space
            android:id="@+id/promotion_news_banner_item_badge_inner_marginLeft"
            android:background="#ff0000"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="@string/promotion_news_banner_item_badge_inner_margin_left_ratio"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/promotion_news_banner_item_badge_icon_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintHeight_default="percent"
            app:layout_constraintHeight_percent="@dimen/promotion_news_banner_item_badge_inner_icon_image_percent"
            app:layout_constraintStart_toEndOf="@+id/promotion_news_banner_item_badge_inner_marginLeft"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/promotion_news_v2_badge_gift_icon"/>
        <Space
            android:id="@+id/promotion_news_banner_item_badge_inner_marginCenter"
            android:background="#000000"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="@string/promotion_news_banner_item_badge_inner_margin_center_ratio"
            app:layout_constraintStart_toEndOf="@+id/promotion_news_banner_item_badge_icon_image"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/promotion_news_banner_item_badge_inner_text_font_size"
            android:textColor="@color/hiveCommonWhite"
            android:gravity="center"
            android:id="@+id/promotion_news_banner_item_badge_text"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:text="@string/hive_promotion_news_banner_item_badge"
            android:maxLines="1"
            android:lineSpacingExtra="3sp"
            android:textAlignment="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHeight_default="percent"
            app:layout_constraintHeight_percent="@dimen/promotion_news_banner_item_badge_inner_text_percent"
            app:layout_constraintStart_toEndOf="@+id/promotion_news_banner_item_badge_inner_marginCenter"
            app:layout_constraintTop_toTopOf="parent"/>
        <Space
            android:id="@+id/promotion_news_banner_item_badge_inner_marginRight"
            android:background="#000000"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="@string/promotion_news_banner_item_badge_inner_margin_right_ratio"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/promotion_news_banner_item_badge_text"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
