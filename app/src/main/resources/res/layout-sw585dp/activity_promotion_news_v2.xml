<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fullscreen_frameLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/com_hive_sdk_promotion_news_activity_background_color"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="542:960"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <Space
                android:id="@+id/uiLayout_marginTop"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.0469"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <Space
                android:id="@+id/uiLayout_marginBottom"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.0708"
                app:layout_constraintStart_toStartOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/uiLayout"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/uiLayout_marginBottom"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/uiLayout_marginTop">
                <FrameLayout
                    android:id="@+id/frameLayout_frameLayout"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="518:828"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_default="percent"
                    app:layout_constraintHeight_percent="0.9775"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="1">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/frameLayout_imageView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:srcCompat="@drawable/promotion_news_frame"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <Space
                            android:id="@+id/contentLayout_marginStart"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintWidth_default="percent"
                            app:layout_constraintWidth_percent="0.0116"/>
                        <Space
                            android:id="@+id/contentLayout_marginEnd"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintWidth_default="percent"
                            app:layout_constraintWidth_percent="0.0116"/>
                        <Space
                            android:id="@+id/contentLayout_marginTop"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHeight_default="percent"
                            app:layout_constraintHeight_percent="0.0072"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <Space
                            android:id="@+id/contentLayout_marginBottom"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHeight_default="percent"
                            app:layout_constraintHeight_percent="0.0072"
                            app:layout_constraintStart_toStartOf="parent"/>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/contentLayout"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintBottom_toTopOf="@+id/contentLayout_marginBottom"
                            app:layout_constraintEnd_toStartOf="@+id/contentLayout_marginEnd"
                            app:layout_constraintStart_toEndOf="@+id/contentLayout_marginStart"
                            app:layout_constraintTop_toBottomOf="@+id/contentLayout_marginTop">
                            <Space
                                android:id="@+id/tabLayout_marginTop"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintHeight_default="percent"
                                app:layout_constraintHeight_percent="0.0343"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/tabLayout"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintHeight_default="percent"
                                app:layout_constraintHeight_percent="0.1005"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tabLayout_marginTop">
                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/tabList"
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"/>
                            </androidx.constraintlayout.widget.ConstraintLayout>
                            <com.hive.promotion.ui.RoundedCornerView
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintHeight_default="percent"
                                app:layout_constraintHeight_percent="0.8885"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintVertical_bias="1"
                                app:round="20dp">
                                <FrameLayout
                                    android:background="#0f000000"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"/>
                            </com.hive.promotion.ui.RoundedCornerView>
                            <com.hive.promotion.ui.RoundedCornerView
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintHeight_default="percent"
                                app:layout_constraintHeight_percent="0.8848"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintVertical_bias="1"
                                app:round="20dp">
                                <FrameLayout
                                    android:id="@+id/contentViewLayout"
                                    android:background="#ffffff"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"/>
                            </com.hive.promotion.ui.RoundedCornerView>
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/contentLayout_bottom"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintHeight_default="percent"
                                app:layout_constraintHeight_percent="0.0527"
                                app:layout_constraintStart_toStartOf="parent">
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:scaleType="fitXY"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:srcCompat="@drawable/promotion_news_v2_frame_bottom"/>
                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:id="@+id/forceLayout"
                                    android:layout_width="wrap_content"
                                    android:layout_height="0dp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent">
                                    <Space
                                        android:id="@+id/forceBtn_marginStart"
                                        android:layout_width="0dp"
                                        android:layout_height="0dp"
                                        app:layout_constraintBottom_toBottomOf="parent"
                                        app:layout_constraintDimensionRatio="15:43"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent"/>
                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:id="@+id/forceBtn"
                                        android:layout_width="0dp"
                                        android:layout_height="0dp"
                                        app:layout_constraintBottom_toBottomOf="parent"
                                        app:layout_constraintDimensionRatio="1:1"
                                        app:layout_constraintHeight_default="percent"
                                        app:layout_constraintHeight_percent="0.6977"
                                        app:layout_constraintStart_toEndOf="@+id/forceBtn_marginStart"
                                        app:layout_constraintTop_toTopOf="parent"
                                        app:srcCompat="@drawable/promotion_news_force_from_off_to_on"/>
                                    <Space
                                        android:id="@+id/forceTextView_marginStart"
                                        android:layout_width="0dp"
                                        android:layout_height="0dp"
                                        app:layout_constraintBottom_toBottomOf="parent"
                                        app:layout_constraintDimensionRatio="7:43"
                                        app:layout_constraintStart_toEndOf="@+id/forceBtn"
                                        app:layout_constraintTop_toTopOf="parent"/>
                                    <androidx.appcompat.widget.AppCompatTextView
                                        android:textColor="?attr/newsOffColor"
                                        android:gravity="center_vertical"
                                        android:id="@+id/forceTextView"
                                        android:layout_width="wrap_content"
                                        android:layout_height="0dp"
                                        android:text="@string/hive_promotion_style_banner"
                                        app:layout_constraintBottom_toBottomOf="parent"
                                        app:layout_constraintStart_toEndOf="@+id/forceTextView_marginStart"
                                        app:layout_constraintTop_toTopOf="parent"/>
                                </androidx.constraintlayout.widget.ConstraintLayout>
                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </FrameLayout>
                <com.hive.ui.view.HiveAnimationButton
                    android:id="@+id/frame_close_btn"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:OffAnimation="@drawable/promotion_news_frame_close_from_up_to_down"
                    app:OnAnimation="@drawable/promotion_news_frame_close_from_down_to_up"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_default="percent"
                    app:layout_constraintHeight_percent="0.0685"
                    app:layout_constraintHorizontal_bias="1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0"
                    app:srcCompat="@drawable/promotion_news_frame_close_from_down_to_up"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
