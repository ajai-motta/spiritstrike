<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/hiveDefaultPopupBackground"
    android:clipToPadding="false"
    android:layout_width="@dimen/com_hive_sdk_repayment_rectangle_width"
    android:layout_height="@dimen/com_hive_sdk_repayment_rectangle_height"
    android:layoutDirection="ltr">
    <TextView
        android:textSize="@dimen/com_hive_sdk_repayment_title_font"
        android:textStyle="normal"
        android:textColor="?attr/fontPopupMain"
        android:gravity="center"
        android:id="@+id/hive_repayment_rectangle_1_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/com_hive_sdk_repayment_title_height"
        android:layout_marginLeft="@dimen/com_hive_sdk_repayment_rectangle_layout_margin"
        android:layout_marginRight="@dimen/com_hive_sdk_repayment_rectangle_layout_margin"
        android:lineSpacingExtra="2sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.core.widget.NestedScrollView
        android:scrollbarSize="3dp"
        android:scrollbarThumbVertical="?attr/hiveDefaultPopupScrollbar"
        android:scrollbarStyle="outsideInset"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/com_hive_sdk_repayment_rectangle_layout_margin"
        android:layout_marginRight="@dimen/com_hive_sdk_repayment_rectangle_layout_margin"
        android:layout_marginBottom="@dimen/com_hive_sdk_repayment_rectangle_layout_margin"
        android:fadeScrollbars="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hive_repayment_rectangle_1_title">
        <TextView
            android:textSize="@dimen/com_hive_sdk_repayment_content_font"
            android:textStyle="normal"
            android:textColor="?attr/fontPopupSub"
            android:gravity="left"
            android:layout_gravity="start"
            android:id="@+id/hive_repayment_rectangle_1_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hive_repayment_rectangle_1_title"/>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
