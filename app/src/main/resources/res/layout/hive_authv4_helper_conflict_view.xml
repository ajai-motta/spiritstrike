<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/bgColor"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:background="?attr/hiveDefaultPopupBackground"
        android:padding="@dimen/com_hive_sdk_conflict_size_20"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/com_hive_sdk_conflict_size_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/com_hive_sdk_conflict_popup_width">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/hive_helper_conflict_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/hive_helper_conflict_dialog_sub_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/com_hive_sdk_conflict_font_20"
                android:textStyle="normal"
                android:textColor="?attr/fontPopupMain"
                android:gravity="left"
                android:id="@+id/hive_helper_conflict_dialog_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hive_authv4helper_dialog_conflictmsg1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.core.widget.NestedScrollView>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/com_hive_sdk_conflict_font_16"
            android:textStyle="normal"
            android:textColor="?attr/commonWhite"
            android:gravity="center"
            android:id="@+id/hive_helper_conflict_dialog_sub_button"
            android:background="?attr/hiveDefaultPopupSubButton"
            android:paddingLeft="@dimen/com_hive_sdk_default_popup_btn_text_padding"
            android:paddingRight="@dimen/com_hive_sdk_default_popup_btn_text_padding"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="@dimen/com_hive_sdk_conflict_btn_height"
            android:layout_marginTop="@dimen/com_hive_sdk_conflict_size_20"
            android:text="@string/hive_authv4helper_dialog_cancel"
            android:paddingHorizontal="@dimen/com_hive_sdk_default_popup_btn_text_padding"
            app:layout_constraintBottom_toTopOf="@+id/hive_helper_conflict_dialog_main_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hive_helper_conflict_scroll_view"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/com_hive_sdk_conflict_font_16"
            android:textStyle="normal"
            android:textColor="?attr/commonWhite"
            android:gravity="center"
            android:id="@+id/hive_helper_conflict_dialog_main_button"
            android:background="?attr/hiveDefaultPopupMainButton"
            android:paddingLeft="@dimen/com_hive_sdk_default_popup_btn_text_padding"
            android:paddingRight="@dimen/com_hive_sdk_default_popup_btn_text_padding"
            android:layout_width="0dp"
            android:layout_height="@dimen/com_hive_sdk_conflict_btn_height"
            android:layout_marginTop="@dimen/com_hive_sdk_conflict_size_20"
            android:text="@string/hive_authv4helper_dialog_ok"
            android:paddingHorizontal="@dimen/com_hive_sdk_default_popup_btn_text_padding"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hive_helper_conflict_dialog_sub_button"
            app:layout_goneMarginStart="0dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
