<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/topCutoutLayout"
        android:background="#000000"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/leftCutoutLayout"
        android:background="#000000"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/rightCutoutLayout"
        android:background="#000000"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:layout_gravity="fill"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/rightCutoutLayout"
        app:layout_constraintStart_toEndOf="@+id/leftCutoutLayout"
        app:layout_constraintTop_toBottomOf="@+id/topCutoutLayout">
        <ProgressBar
            android:id="@+id/hive_authv4_webview_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
        <com.hive.core.webview.HiveWebView
            android:id="@+id/hive_authv4_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.hive.ui.view.HiveAnimationButton
            android:id="@+id/hive_authv4_close_button"
            android:layout_width="@dimen/authv4_dialog_close_btn_size"
            android:layout_height="@dimen/authv4_dialog_close_btn_size"
            android:layout_marginTop="@dimen/authv4_signinapple_dialog_close_btn_margin_top"
            android:layout_marginRight="@dimen/authv4_signinapple_dialog_close_btn_margin_right"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            app:OffAnimation="?attr/authv4CloseBtnUp"
            app:OnAnimation="?attr/authv4CloseBtnDown"
            app:srcCompat="?attr/authv4CloseBtnDown"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
