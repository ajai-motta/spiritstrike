<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fullscreen_frameLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/com_hive_sdk_promotion_news_activity_background_color"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layoutDirection="ltr"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="360:635"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <Space
                android:id="@+id/uiLayout_marginStart"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent="0.0305"/>
            <Space
                android:id="@+id/uiLayout_marginEnd"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent="0.0039"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/uiLayout"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/uiLayout_marginEnd"
                app:layout_constraintStart_toEndOf="@+id/uiLayout_marginStart"
                app:layout_constraintTop_toTopOf="parent">
                <FrameLayout
                    android:id="@+id/frameLayout_frameLayout"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="338:594"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.5"
                    app:layout_constraintWidth_default="percent"
                    app:layout_constraintWidth_percent="0.9656">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/frameLayout_imageView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:srcCompat="@drawable/promotion_news_frame"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <Space
                            android:id="@+id/contentLayout_marginStart"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintWidth_default="percent"
                            app:layout_constraintWidth_percent="0.0125"/>
                        <Space
                            android:id="@+id/contentLayout_marginEnd"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintWidth_default="percent"
                            app:layout_constraintWidth_percent="0.0125"/>
                        <Space
                            android:id="@+id/contentLayout_marginTop"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHeight_default="percent"
                            app:layout_constraintHeight_percent="0.007"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <Space
                            android:id="@+id/contentLayout_marginBottom"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHeight_default="percent"
                            app:layout_constraintHeight_percent="0.007"
                            app:layout_constraintStart_toStartOf="parent"/>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/contentLayout"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintBottom_toTopOf="@+id/contentLayout_marginBottom"
                            app:layout_constraintEnd_toStartOf="@+id/contentLayout_marginEnd"
                            app:layout_constraintStart_toEndOf="@+id/contentLayout_marginStart"
                            app:layout_constraintTop_toBottomOf="@+id/contentLayout_marginTop">
                            <Space
                                android:id="@+id/tabLayout_marginTop"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintHeight_default="percent"
                                app:layout_constraintHeight_percent="0.0256"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/tabLayout"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layoutDirection="ltr"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintHeight_default="percent"
                                app:layout_constraintHeight_percent="0.1009"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tabLayout_marginTop">
                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/tabList"
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"/>
                            </androidx.constraintlayout.widget.ConstraintLayout>
                            <com.hive.promotion.ui.RoundedCornerView
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintHeight_default="percent"
                                app:layout_constraintHeight_percent="0.8961"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintVertical_bias="1">
                                <FrameLayout
                                    android:background="#0f000000"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"/>
                            </com.hive.promotion.ui.RoundedCornerView>
                            <com.hive.promotion.ui.RoundedCornerView
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintHeight_default="percent"
                                app:layout_constraintHeight_percent="0.8923"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintVertical_bias="1">
                                <FrameLayout
                                    android:id="@+id/contentViewLayout"
                                    android:background="#ffffff"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"/>
                            </com.hive.promotion.ui.RoundedCornerView>
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/contentLayout_bottom"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layoutDirection="ltr"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintHeight_default="percent"
                                app:layout_constraintHeight_percent="0.0646"
                                app:layout_constraintStart_toStartOf="parent">
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:scaleType="fitXY"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:srcCompat="@drawable/promotion_news_v2_frame_bottom"/>
                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:id="@+id/forceLayout"
                                    android:layout_width="wrap_content"
                                    android:layout_height="0dp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent">
                                    <Space
                                        android:id="@+id/forceBtn_marginStart"
                                        android:layout_width="0dp"
                                        android:layout_height="0dp"
                                        app:layout_constraintBottom_toBottomOf="parent"
                                        app:layout_constraintDimensionRatio="10:30"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent"/>
                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:id="@+id/forceBtn"
                                        android:layout_width="0dp"
                                        android:layout_height="0dp"
                                        app:layout_constraintBottom_toBottomOf="parent"
                                        app:layout_constraintDimensionRatio="1:1"
                                        app:layout_constraintHeight_default="percent"
                                        app:layout_constraintHeight_percent="0.72"
                                        app:layout_constraintStart_toEndOf="@+id/forceBtn_marginStart"
                                        app:layout_constraintTop_toTopOf="parent"
                                        app:srcCompat="@drawable/promotion_news_force_from_off_to_on"/>
                                    <Space
                                        android:id="@+id/forceTextView_marginStart"
                                        android:layout_width="0dp"
                                        android:layout_height="0dp"
                                        app:layout_constraintBottom_toBottomOf="parent"
                                        app:layout_constraintDimensionRatio="6:30"
                                        app:layout_constraintStart_toEndOf="@+id/forceBtn"
                                        app:layout_constraintTop_toTopOf="parent"/>
                                    <androidx.appcompat.widget.AppCompatTextView
                                        android:textColor="?attr/newsOffColor"
                                        android:gravity="center_vertical"
                                        android:id="@+id/forceTextView"
                                        android:layout_width="wrap_content"
                                        android:layout_height="0dp"
                                        android:text="@string/hive_promotion_style_banner"
                                        app:layout_constraintBottom_toBottomOf="parent"
                                        app:layout_constraintStart_toEndOf="@+id/forceTextView_marginStart"
                                        app:layout_constraintTop_toTopOf="parent"/>
                                </androidx.constraintlayout.widget.ConstraintLayout>
                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </FrameLayout>
                <com.hive.ui.view.HiveAnimationButton
                    android:id="@+id/frame_close_btn"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layoutDirection="ltr"
                    app:OffAnimation="@drawable/promotion_news_frame_close_from_up_to_down"
                    app:OnAnimation="@drawable/promotion_news_frame_close_from_down_to_up"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0"
                    app:layout_constraintWidth_default="percent"
                    app:layout_constraintWidth_percent="0.1243"
                    app:srcCompat="@drawable/promotion_news_frame_close_from_down_to_up"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
