<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/hiveDefaultPopupBackground"
    android:clipToPadding="false"
    android:layout_width="@dimen/com_hive_sdk_repayment_rectangle_width"
    android:layout_height="@dimen/com_hive_sdk_repayment_rectangle_height"
    android:layoutDirection="ltr">
    <TextView
        android:textSize="@dimen/com_hive_sdk_repayment_title_font"
        android:textStyle="normal"
        android:textColor="?attr/fontPopupMain"
        android:gravity="center"
        android:id="@+id/hive_repayment_rectangle_2_title"
        android:layout_width="0dp"
        android:layout_height="@dimen/com_hive_sdk_repayment_title_height"
        android:layout_marginLeft="@dimen/com_hive_sdk_repayment_rectangle_layout_margin"
        android:lineSpacingExtra="2sp"
        app:layout_constraintEnd_toStartOf="@+id/hive_repayment_rectangle_2_refresh"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/hive_repayment_rectangle_2_refresh"
        android:padding="12dp"
        android:layout_width="@dimen/com_hive_sdk_repayment_title_height"
        android:layout_height="@dimen/com_hive_sdk_repayment_title_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/com_hive_repayment_refresh_button"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/hive_repayment_rectangle_2_recycler_view"
        android:background="?attr/com_hive_repayment_item_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/com_hive_sdk_repayment_rectangle_2_content_layout_margin"
        android:layout_marginRight="@dimen/com_hive_sdk_repayment_rectangle_2_content_layout_margin"
        app:layout_constraintBottom_toTopOf="@+id/hive_repayment_rectangle_2_cs_code"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hive_repayment_rectangle_2_title"/>
    <TextView
        android:textSize="@dimen/com_hive_sdk_repayment_cs_code_font"
        android:textStyle="normal"
        android:textColor="?attr/fontPopupSub"
        android:gravity="center"
        android:id="@+id/hive_repayment_rectangle_2_cs_code"
        android:layout_width="match_parent"
        android:layout_height="@dimen/com_hive_sdk_repayment_cs_code_height"
        android:layout_marginLeft="@dimen/com_hive_sdk_repayment_rectangle_layout_margin"
        android:layout_marginTop="@dimen/com_hive_sdk_repayment_cs_code_layout_margin"
        android:layout_marginRight="@dimen/com_hive_sdk_repayment_rectangle_layout_margin"
        android:layout_marginBottom="@dimen/com_hive_sdk_repayment_cs_code_layout_margin"
        android:lineSpacingExtra="2sp"
        app:layout_constraintBottom_toTopOf="@+id/hive_repayment_button_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hive_repayment_rectangle_2_recycler_view"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/hive_repayment_button_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/com_hive_sdk_repayment_button_height"
        android:layout_marginLeft="@dimen/com_hive_sdk_repayment_rectangle_layout_margin"
        android:layout_marginRight="@dimen/com_hive_sdk_repayment_rectangle_layout_margin"
        android:layout_marginBottom="@dimen/com_hive_sdk_repayment_rectangle_layout_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="@dimen/com_hive_sdk_repayment_rectangle_2_item_button_font"
            android:textStyle="normal"
            android:textColor="?attr/commonWhite"
            android:gravity="center"
            android:id="@+id/hive_repayment_rectangle_2_inquire_button"
            android:background="?attr/hiveDefaultPopupSubButton"
            android:layout_width="@dimen/com_hive_sdk_repayment_button_width"
            android:layout_height="@dimen/com_hive_sdk_repayment_button_height"
            android:lineSpacingExtra="2sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/com_hive_sdk_repayment_rectangle_2_item_button_font"
            android:textStyle="normal"
            android:textColor="?attr/bgPopup"
            android:gravity="center"
            android:id="@+id/hive_repayment_rectangle_2_start_game_button"
            android:background="?attr/com_hive_repayment_item_start_game_button"
            android:layout_width="@dimen/com_hive_sdk_repayment_button_width"
            android:layout_height="@dimen/com_hive_sdk_repayment_button_height"
            android:lineSpacingExtra="2sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
