<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/hiveAgeGateBackground"
    android:paddingLeft="@dimen/authv4_agegate_dialog_view_margin_left"
    android:paddingTop="@dimen/authv4_agegate_dialog_view_margin_top"
    android:paddingRight="@dimen/authv4_agegate_dialog_view_margin_left"
    android:paddingBottom="@dimen/authv4_agegate_dialog_view_margin_top"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:paddingHorizontal="@dimen/authv4_agegate_dialog_view_margin_left"
    android:paddingVertical="@dimen/authv4_agegate_dialog_view_margin_top">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/hive_agegate_main"
        android:background="?attr/hiveAgeGatePopupBackground"
        android:padding="@dimen/authv4_agegate_dialog_popup_left_margin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/authv4_agegate_dialog_popup_width_max">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/hiveAgeGatePopupTitleTextColor"
            android:gravity="center"
            android:id="@+id/hive_agegate_title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/authv4_agegate_dialog_popup_title_height"
            android:text="@string/authv4_agegate_popup_title"
            android:maxLines="1"
            app:autoSizeMaxTextSize="@dimen/authv4_agegate_dialog_font_size_24"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            app:layout_constrainedHeight="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/authv4_agegate_dialog_font_size_20"
            android:textStyle="normal"
            android:textColor="?attr/hiveAgeGatePopupBirthTextColor"
            android:gravity="center"
            android:id="@+id/hive_agegate_birth_date_first"
            android:background="?attr/hiveAgeGatePopupBirthTextView"
            android:layout_width="0dp"
            android:layout_height="@dimen/authv4_agegate_dialog_popup_birth_height"
            android:layout_marginTop="@dimen/authv4_agegate_dialog_size_30"
            android:text="MM"
            android:maxLines="1"
            app:layout_constraintEnd_toStartOf="@+id/hive_agegate_birth_date_second"
            app:layout_constraintHorizontal_weight="70"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hive_agegate_title"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/authv4_agegate_dialog_font_size_20"
            android:textStyle="normal"
            android:textColor="?attr/hiveAgeGatePopupBirthTextColor"
            android:gravity="center"
            android:id="@+id/hive_agegate_birth_date_second"
            android:background="?attr/hiveAgeGatePopupBirthTextView"
            android:layout_width="0dp"
            android:layout_height="@dimen/authv4_agegate_dialog_popup_birth_height"
            android:layout_marginLeft="@dimen/authv4_agegate_dialog_size_10"
            android:layout_marginTop="@dimen/authv4_agegate_dialog_size_30"
            android:text="DD"
            android:maxLines="1"
            app:layout_constraintEnd_toStartOf="@+id/hive_agegate_birth_date_third"
            app:layout_constraintHorizontal_weight="70"
            app:layout_constraintStart_toEndOf="@+id/hive_agegate_birth_date_first"
            app:layout_constraintTop_toBottomOf="@+id/hive_agegate_title"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/authv4_agegate_dialog_font_size_20"
            android:textStyle="normal"
            android:textColor="?attr/hiveAgeGatePopupBirthTextColor"
            android:gravity="center"
            android:id="@+id/hive_agegate_birth_date_third"
            android:background="?attr/hiveAgeGatePopupBirthTextView"
            android:layout_width="0dp"
            android:layout_height="@dimen/authv4_agegate_dialog_popup_birth_height"
            android:layout_marginLeft="@dimen/authv4_agegate_dialog_size_10"
            android:layout_marginTop="@dimen/authv4_agegate_dialog_size_30"
            android:text="YYYY"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="100"
            app:layout_constraintStart_toEndOf="@+id/hive_agegate_birth_date_second"
            app:layout_constraintTop_toBottomOf="@+id/hive_agegate_title"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/authv4_agegate_dialog_font_size_16"
            android:textStyle="normal"
            android:textColor="?attr/hiveAgeGatePopupOKButtonTextColor"
            android:gravity="center"
            android:id="@+id/hive_agegate_active_button"
            android:background="?attr/hiveAgeGatePopupOKButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/authv4_agegate_dialog_size_48"
            android:layout_marginTop="@dimen/authv4_agegate_dialog_size_30"
            android:text="@string/authv4_agegate_popup_ok_button"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hive_agegate_birth_date_first"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/authv4_agegate_dialog_font_size_16"
            android:textStyle="normal"
            android:textColor="?attr/hiveAgeGatePopupCancelButtonTextColor"
            android:gravity="center"
            android:id="@+id/hive_agegate_v2_cancel_button"
            android:background="?attr/hiveAgeGatePopupCancelButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/authv4_agegate_dialog_size_48"
            android:layout_marginTop="@dimen/authv4_agegate_dialog_size_30"
            android:text="@string/authv4_agegate_popup_cancel_button"
            android:maxLines="1"
            app:layout_constraintEnd_toStartOf="@+id/hive_agegate_v2_active_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hive_agegate_birth_date_first"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/authv4_agegate_dialog_font_size_16"
            android:textStyle="normal"
            android:textColor="?attr/hiveAgeGatePopupOKButtonTextColor"
            android:gravity="center"
            android:id="@+id/hive_agegate_v2_active_button"
            android:background="?attr/hiveAgeGatePopupOKButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/authv4_agegate_dialog_size_48"
            android:layout_marginLeft="@dimen/authv4_agegate_dialog_popup_left_margin"
            android:layout_marginTop="@dimen/authv4_agegate_dialog_size_30"
            android:text="@string/authv4_agegate_popup_ok_button"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/hive_agegate_v2_cancel_button"
            app:layout_constraintTop_toBottomOf="@+id/hive_agegate_birth_date_first"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
