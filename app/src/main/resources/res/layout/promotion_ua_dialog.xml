<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/root_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/promotion_ua_root"
            android:background="?attr/hiveDefaultPopupBackground"
            android:layout_width="@dimen/com_hive_sdk_ua_share_popup_3btn_width"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <Space
                android:id="@+id/hive_default_popup_top_margin"
                android:layout_width="match_parent"
                android:layout_height="@dimen/com_hive_sdk_default_popup_top_margin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/com_hive_sdk_ua_share_popup_title_text_size"
                android:textStyle="normal"
                android:textColor="?attr/fontPopupMain"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/promotion_ua_share_textview_share"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/hive_promotion_share_title"
                android:textAlignment="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/hive_default_popup_top_margin"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/promotion_ua_share_bottom_body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/com_hive_sdk_ua_share_popup_middle_margin"
                android:layout_marginBottom="@dimen/com_hive_sdk_ua_share_popup_bottom_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/promotion_ua_share_textview_share">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/promotion_ua_share_bottom_body_row1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/com_hive_sdk_ua_share_2btn_area_left_margin">
                    <FrameLayout
                        android:layout_width="62dp"
                        android:layout_height="62dp">
                        <com.hive.promotion.PromotionUAShareButton
                            android:layout_gravity="center"
                            android:id="@+id/promotion_ua_share_button_000"
                            android:layout_width="54dp"
                            android:layout_height="54dp"/>
                    </FrameLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/promotion_ua_share_bottom_body_row2"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/com_hive_sdk_ua_share_2btn_area_left_margin"
                    android:layout_marginTop="@dimen/com_hive_sdk_ua_share_btn_area_top_margin"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/promotion_ua_share_bottom_body_row3"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/com_hive_sdk_ua_share_2btn_area_left_margin"
                    android:layout_marginTop="@dimen/com_hive_sdk_ua_share_btn_area_top_margin"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <Space
            android:id="@+id/close_image_space"
            android:layout_width="3dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/promotion_ua_root"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.hive.ui.view.HiveAnimationButton
            android:id="@+id/promotion_ua_share_btn_close_image"
            android:padding="@dimen/com_hive_sdk_default_popup_size_8"
            android:layout_width="@dimen/com_hive_sdk_default_popup_close_btn_size"
            android:layout_height="@dimen/com_hive_sdk_default_popup_close_btn_size"
            app:OffAnimation="?attr/authv4CloseBtnUp"
            app:OnAnimation="?attr/authv4CloseBtnDown"
            app:layout_constraintEnd_toEndOf="@+id/root_layout"
            app:layout_constraintTop_toTopOf="@+id/root_layout"
            app:srcCompat="?attr/authv4CloseBtnDown"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
